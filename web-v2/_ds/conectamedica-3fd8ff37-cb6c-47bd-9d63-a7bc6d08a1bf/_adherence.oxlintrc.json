{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/notices/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4|Inter|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4, Inter, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|single|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, single, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|errors|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<AppointmentForm> doesn't accept that prop. Declared props: state, errors, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentForm'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|loading|sent)$/]",
        "message": "<AppointmentForm> state must be one of 'idle' | 'loading' | 'sent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumbs> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|loading|disabled|fullWidth|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, loading, disabled, fullWidth, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClinicalDisclaimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<ClinicalDisclaimer> doesn't accept that prop. Declared props: style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConectaLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|src|plate|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<ConectaLogo> doesn't accept that prop. Declared props: variant, height, src, plate, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConectaLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|full|isotype)$/]",
        "message": "<ConectaLogo> variant must be one of 'lockup' | 'full' | 'isotype'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConectaThread'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|nodes|active|animate|thickness|nodeRadius|className|style|key|ref|className|style|children)$/]",
        "message": "<ConectaThread> doesn't accept that prop. Declared props: orientation, nodes, active, animate, thickness, nodeRadius, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConectaThread'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<ConectaThread> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|help|error|required|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: id, label, help, error, required, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|set|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, set, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='set'] > Literal[value!=/^(?:lucide|simple)$/]",
        "message": "<Icon> set must be one of 'lucide' | 'simple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<InfoNote> doesn't accept that prop. Declared props: title, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|note|style|key|ref|className|style|children)$/]",
        "message": "<PriceBlock> doesn't accept that prop. Declared props: amount, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfessionalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|subtitle|href|photoSrc|initials|style|key|ref|className|style|children)$/]",
        "message": "<ProfessionalCard> doesn't accept that prop. Declared props: name, role, subtitle, href, photoSrc, initials, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pullquote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|source|kind|style|key|ref|className|style|children)$/]",
        "message": "<Pullquote> doesn't accept that prop. Declared props: children, source, kind, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pullquote'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:quote|data)$/]",
        "message": "<Pullquote> kind must be one of 'quote' | 'data'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:videoId|title|duration|kicker|style|key|ref|className|style|children)$/]",
        "message": "<ResourceCard> doesn't accept that prop. Declared props: videoId, title, duration, kicker, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|title|summary|href|icon|chips|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: level, title, summary, href, icon, chips, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:axis|orbit)$/]",
        "message": "<ServiceCard> level must be one of 'axis' | 'orbit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: logoSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|compressed|layout|menuOpen|onToggleMenu|logoSrc|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: items, active, compressed, layout, menuOpen, onToggleMenu, logoSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<SiteHeader> layout must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: kind, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:telemedicina|presencial|sabado)$/]",
        "message": "<StatusChip> kind must be one of 'telemedicina' | 'presencial' | 'sabado'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|active|style|key|ref|className|style|children)$/]",
        "message": "<StepBlock> doesn't accept that prop. Declared props: number, title, children, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|external|arrow|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, external, arrow, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrgencyNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|style|key|ref|className|style|children)$/]",
        "message": "<UrgencyNotice> doesn't accept that prop. Declared props: tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrgencyNotice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|flat)$/]",
        "message": "<UrgencyNotice> tone must be one of 'surface' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|message|variant|label|style|key|ref|className|style|children)$/]",
        "message": "<WhatsAppButton> doesn't accept that prop. Declared props: phone, message, variant, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:floating|inline)$/]",
        "message": "<WhatsAppButton> variant must be one of 'floating' | 'inline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
