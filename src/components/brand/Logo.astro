---
/* Logo. Ahora vectorial.

   Hasta acá el logo era un recorte del JPG original con background-position, que
   a 44px de alto perdía casi toda la legibilidad de "Clinica". Ahora son SVG
   trazados del mismo archivo (ver scripts/logo-vector.mjs): la misma marca, sin
   redibujar nada, nítida a cualquier tamaño.

   Dos versiones porque el pie de página es azul profundo: la de color y una
   monocroma blanca. No se recolorea por CSS —son dos tintas distintas— así que
   son dos archivos. */
interface Props {
  variante?: 'lockup' | 'isotipo';
  alto?: number;
  tono?: 'color' | 'blanco';
  alt?: string;
  clase?: string | undefined;
}
const {
  variante = 'lockup',
  alto = 44,
  tono = 'color',
  alt = 'Clínica Conecta',
  clase,
} = Astro.props;

// Proporciones reales de los archivos trazados.
const PROPORCION = { lockup: 2472 / 996, isotipo: 186 / 210 } as const;
const archivo = `/marca/${variante}${tono === 'blanco' ? '-blanco' : ''}.svg`;
const ancho = Math.round(alto * PROPORCION[variante]);
---

<img
  class:list={['logo', clase]}
  src={archivo}
  alt={alt}
  width={ancho}
  height={alto}
  style={`height:${alto}px;width:${ancho}px`}
  loading="eager"
  decoding="async"
/>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
  }
</style>
