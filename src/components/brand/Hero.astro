---
/* Hero a pantalla completa.

   Reemplaza al hero anterior, que era texto sobre blanco con la fotografía
   debajo: dos bloques que no se leían como uno. Acá la imagen ES el hero y el
   titular va encima, abajo a la izquierda, como en la referencia que pidió el
   cliente.

   Tres decisiones que sostienen que esto funcione y no sea solo "una foto
   grande":

   1. Un degradado de dos paradas sobre la imagen. Sin él, el texto blanco es
      ilegible en cuanto la foto tiene una zona clara, y una foto de luz natural
      siempre la tiene. El degradado es más denso abajo a la izquierda, que es
      donde cae el texto.

   2. La imagen se marca `eager` y `fetchpriority="high"`. Es el elemento LCP por
      definición, así que hay que pedirla primero, no diferirla.

   3. Altura `100svh`, no `100vh`. En móvil, `vh` incluye la barra del navegador
      y el hero termina cortado por debajo del pliegue.

   El video es opcional y se monta solo si el navegador no pide movimiento
   reducido. La imagen siempre está debajo, así que si el video no carga —o el
   usuario pidió menos movimiento— el hero se ve igual de bien. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagen: ImageMetadata;
  alt: string;
  video?: string | undefined;
  eyebrow?: string | undefined;
  titulo: string;
  bajada?: string | undefined;
  alto?: 'completo' | 'medio';
}
const { imagen, alt, video, eyebrow, titulo, bajada, alto = 'completo' } = Astro.props;
---

<section class="hero" data-alto={alto}>
  <div class="fondo">
    <Picture
      src={imagen}
      alt={alt}
      widths={[800, 1280, 1920, 2560]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    {
      video && (
        <video
          class="video"
          src={video}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        />
      )
    }
    <span class="velo" aria-hidden="true"></span>
  </div>

  <div class="texto contenedor">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="titular-hero">{titulo}</h1>
    {bajada && <p class="bajada">{bajada}</p>}
    <div class="acciones"><slot /></div>
  </div>

  <span class="borde-inferior" aria-hidden="true"></span>
</section>

<script>
  /* El video solo se reproduce si el usuario no pidió movimiento reducido y la
     conexión no está marcada como ahorro de datos. En cualquier otro caso se
     queda la fotografía, que ya está cargada. */
  const video = document.querySelector<HTMLVideoElement>('.hero .video');
  if (video) {
    const conexion = (navigator as { connection?: { saveData?: boolean } }).connection;
    const quietud = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (quietud || conexion?.saveData) {
      video.remove();
    } else {
      video.preload = 'auto';
      video.addEventListener('canplay', () => video.classList.add('visible'), { once: true });
      video.play().catch(() => video.remove());
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-blue-deep);
  }
  .hero[data-alto='medio'] {
    min-height: 62svh;
  }

  .fondo {
    position: absolute;
    inset: 0;
  }
  .fondo :global(img),
  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .video:global(.visible) {
    opacity: 1;
  }

  /* Dos degradados: uno vertical para el pie y otro diagonal que carga el
     lado izquierdo, que es donde vive el texto. */
  /* Tres capas, cada una con un trabajo distinto:
     - abajo, para que el texto se lea sobre cualquier foto;
     - a la izquierda, donde vive el bloque de texto;
     - arriba, una franja corta que le garantiza contraste a la cabecera
       transparente sin oscurecer el resto de la imagen.
     El centro-derecha queda casi limpio: ahí se ve la fotografía. */
  .velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(6, 24, 54, 0.86) 0%,
        rgba(6, 24, 54, 0.55) 22%,
        rgba(6, 24, 54, 0.08) 52%,
        rgba(6, 24, 54, 0) 72%
      ),
      linear-gradient(to right, rgba(6, 24, 54, 0.62) 0%, rgba(6, 24, 54, 0.12) 46%, rgba(6, 24, 54, 0) 68%),
      linear-gradient(to bottom, rgba(6, 24, 54, 0.5) 0%, rgba(6, 24, 54, 0) 18%);
  }

  .texto {
    position: relative;
    padding-block: var(--space-16) var(--space-16);
    color: #fff;
  }
  @media (min-width: 900px) {
    .texto {
      padding-block: var(--space-20) var(--space-24);
    }
  }

  .texto .eyebrow {
    color: #a9c4e8;
  }

  .titular-hero {
    margin-top: var(--space-5);
    max-width: 15ch;
    color: #fff;
  }

  .bajada {
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: #dce7f7;
    max-width: 44ch;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* Sobre fotografía, el secundario en azul sobre azul no se lee. Se invierte:
     borde y texto blancos, relleno translúcido con desenfoque detrás. */
  .acciones :global(.btn[data-variante='secondary']) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
  }
  .acciones :global(.btn[data-variante='secondary']:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
  }
  .acciones :global(.btn[data-variante='primary']) {
    background: #fff;
    color: var(--color-blue-deep);
  }
  .acciones :global(.btn[data-variante='primary']:hover) {
    background: #d6e3f7;
  }

  /* Una línea fina del azul de marca cerrando el hero: es el hilo Conecta
     naciendo, y separa el hero de la sección siguiente sin un borde duro. */
  .borde-inferior {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--color-blue);
  }
</style>
