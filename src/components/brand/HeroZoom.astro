---
/* Hero en dos actos.

   ACTO 1 · Santiago. Un zoom sobre la vista aérea de la ciudad, movido por el
   scroll. Responde la primera pregunta de quien entra: dónde queda esto.

   ACTO 2 · La clínica, en video. Al terminar el zoom entra el video y aparecen
   los valores de la clínica y los botones de acción.

   Por qué el acto 1 es zoom en CSS y el acto 2 es video:

   Un zoom es el peor caso para comprimir video —se mueve cada píxel en cada
   fotograma, así que no hay nada que reutilizar entre ellos— y por eso la
   primera versión de esto, que era video, se veía pixelada. Hecho con `scale()`
   sobre una imagen de 4096 px, la GPU remuestrea del original y queda nítido en
   todo el recorrido.

   Y `sizes="170vw"`, no `100vw`: el zoom amplía hasta 1,55×, así que pedir solo
   el ancho de pantalla dejaría la imagen estirada justo en el punto más cerrado.

   El acto 2 es lo contrario: cámara casi fija. Ahí la compresión funciona bien y
   el video entero pesa 583 KB, con el movimiento real que una foto no da.

   Sobre el material del acto 2: es material generado, y en ninguna parte del
   sitio se afirma que sea el equipo de Conecta ni que la clínica esté operando.
   El texto alternativo lo describe como lo que es. Cuando el espacio esté
   habilitado y haya equipo, se graba de verdad y se reemplaza `v-clinica`:
   ningún otro archivo cambia. Ver `docs/preguntas-carlos.md` §F. */
import { Picture } from 'astro:assets';
import santiago from '../../assets/viaje/viaje-1-santiago.jpg';

interface Props {
  titulo: string;
  bajada: string;
}
const { titulo, bajada } = Astro.props;

/* Los mismos seis valores que se publican en Conócenos. Principio de
   repetición: si el hero dijera otra cosa, serían dos promesas distintas. */
const VALORES = [
  'Excelencia clínica',
  'Atención humanizada',
  'Transparencia en los precios',
  'Confidencialidad',
  'Cercanía',
  'Coordinación',
];

/* Punto del scroll donde termina el zoom y empieza el video, y cuánto dura el
   cruce entre los dos. */
const CORTE = 0.55;
const CRUCE = 0.12;
---

<section class="hero-dos" id="viaje" data-corte={CORTE} data-cruce={CRUCE}>
  <div class="pegado">
    <div class="lienzo">
      <div class="acto1-fondo">
        <Picture
          src={santiago}
          alt="Vista aérea de Santiago de Chile al atardecer, con la cordillera de los Andes al fondo."
          widths={[1400, 2000, 2600, 3400, 4096]}
          sizes="170vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="acto2-fondo">
        <img class="poster" src="/video/v-clinica.jpg" alt="" aria-hidden="true" />
        <video
          class="pelicula"
          id="video-clinica"
          poster="/video/v-clinica.jpg"
          preload="none"
          muted
          loop
          playsinline
          aria-hidden="true"
          data-fuente="/video/v-clinica.mp4"></video>
      </div>

      <span class="velo" aria-hidden="true"></span>
    </div>

    <div class="texto contenedor">
      <div class="acto acto-1">
        <p class="eyebrow">Santiago de Chile · Comuna de Ñuñoa</p>
        <h1 class="titular-hero">{titulo}</h1>
        <p class="bajada">{bajada}</p>
      </div>

      <div class="acto acto-2">
        <p class="eyebrow">Cómo atendemos</p>
        <ul class="valores">
          {
            VALORES.map((v, i) => (
              <li class="valor" style={`--orden:${i}`}>
                {v}
              </li>
            ))
          }
        </ul>
        <div class="acciones"><slot /></div>
      </div>
    </div>

    <a class="seguir" href="#como-funciona" aria-label="Bajar al contenido">
      <span class="seguir-linea" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  const seccion = document.getElementById('viaje');
  const video = document.getElementById('video-clinica') as HTMLVideoElement | null;

  if (seccion) {
    const acto1 = seccion.querySelector<HTMLElement>('.acto-1');
    const acto2 = seccion.querySelector<HTMLElement>('.acto-2');
    const corte = Number(seccion.dataset['corte'] ?? 0.55);
    const cruce = Number(seccion.dataset['cruce'] ?? 0.12);
    const quietud = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conexion = (navigator as { connection?: { saveData?: boolean } }).connection;
    const sinVideo = quietud.matches || Boolean(conexion?.saveData);

    if (video && !sinVideo) {
      /* El video solo tapa su póster mientras corre de verdad. Si algo lo pausa
         —una pestaña en segundo plano, una política de reproducción automática,
         una red que se corta— reaparece el póster en vez de un bloque liso. */
      video.addEventListener('playing', () => video.classList.add('corriendo'));
      for (const ev of ['pause', 'ended', 'error', 'stalled']) {
        video.addEventListener(ev, () => video.classList.remove('corriendo'));
      }
    }

    const pintar = (avance: number) => {
      /* Avance dentro del zoom de Santiago, de 0 a 1. */
      const zoom = Math.min(1, avance / corte);
      seccion.style.setProperty('--zoom', String(zoom));

      /* Cruce hacia el video. Empieza un poco antes del corte para que el video
         ya esté encima cuando el zoom termina, y no se vea el salto. */
      const paso = Math.min(1, Math.max(0, (avance - (corte - cruce)) / cruce));
      seccion.style.setProperty('--paso', String(paso));

      acto1?.style.setProperty('--visible', String(1 - paso));
      acto2?.style.setProperty('--visible', String(paso));
      acto1?.toggleAttribute('data-activo', paso < 0.5);
      acto2?.toggleAttribute('data-activo', paso >= 0.5);
      seccion.style.setProperty('--avance', String(avance));

      /* El video no se descarga hasta que el cruce empieza de verdad. */
      if (video && !sinVideo) {
        if (paso > 0.02) {
          if (!video.getAttribute('src')) {
            video.src = video.dataset['fuente'] ?? '';
            video.preload = 'auto';
          }
          if (video.paused) video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      }
    };

    if (quietud.matches) {
      pintar(0);
    } else {
      let pedido = false;
      const alScrollear = () => {
        if (pedido) return;
        pedido = true;
        requestAnimationFrame(() => {
          pedido = false;
          const caja = seccion.getBoundingClientRect();
          const recorrido = caja.height - window.innerHeight;
          pintar(recorrido <= 0 ? 0 : Math.min(1, Math.max(0, -caja.top / recorrido)));
        });
      };
      addEventListener('scroll', alScrollear, { passive: true });
      addEventListener('resize', alScrollear, { passive: true });
      alScrollear();
    }
  }
</script>

<style>
  /* La altura es la distancia de scroll que dura el hero completo. Con 300svh
     sobraba casi la mitad: el zoom terminaba y quedaban 135svh en los que no
     pasaba nada más que el video en bucle. 200svh reparte 55% al zoom y 45% al
     video, que alcanza para leer los seis valores sin que se sienta detenido. */
  .hero-dos {
    position: relative;
    height: 175svh;
    background: var(--color-blue-deep);
  }
  @media (min-width: 900px) {
    .hero-dos {
      height: 200svh;
    }
  }

  .pegado {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .lienzo {
    position: absolute;
    inset: 0;
  }

  /* ---- Acto 1: el zoom sobre Santiago ---- */
  .acto1-fondo {
    position: absolute;
    inset: 0;
    /* De 1 a 1,55 a lo largo del zoom, bajando levemente: la cámara se acerca
       y desciende, no solo se acerca. */
    transform: scale(calc(1 + 0.55 * var(--zoom, 0)))
      translate3d(0, calc(var(--zoom, 0) * 4%), 0);
    transform-origin: center 42%;
    opacity: calc(1 - var(--paso, 0));
    will-change: transform, opacity;
  }
  .acto1-fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---- Acto 2: el video de la clínica ---- */
  .acto2-fondo {
    position: absolute;
    inset: 0;
    opacity: var(--paso, 0);
    /* Un acercamiento muy leve y continuo, atado al scroll y no al cruce: el
       video sigue moviéndose mientras se leen los valores, en vez de quedarse
       congelado apenas termina la transición. Parte en 1 para no ampliar un
       archivo de 1080p más de lo necesario. */
    transform: scale(calc(1 + 0.06 * var(--avance, 0)));
    will-change: transform, opacity;
  }
  .poster,
  .pelicula {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pelicula {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .pelicula:global(.corriendo) {
    opacity: 1;
  }

  .velo {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: var(--velo);
  }

  /* ---- Texto ---- */
  .texto {
    position: relative;
    z-index: 21;
    display: grid;
    grid-template-areas: 'acto';
    padding-block: var(--space-16);
    color: #fff;
  }
  @media (min-width: 900px) {
    .texto {
      padding-block: var(--space-20) var(--space-24);
    }
  }

  /* Los dos actos ocupan la misma celda y se turnan, para que el bloque no
     salte de alto al cambiar. */
  .acto {
    grid-area: acto;
    opacity: var(--visible, 0);
    transform: translateY(calc((1 - var(--visible, 0)) * 14px));
    transition:
      opacity var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-out);
  }
  .acto-1 {
    --visible: 1;
  }
  .acto:not([data-activo]) {
    pointer-events: none;
  }

  .acto .eyebrow {
    color: #a9c4e8;
  }
  .titular-hero {
    margin-top: var(--space-5);
    max-width: 15ch;
    color: #fff;
  }
  .bajada {
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: #dce7f7;
    max-width: 44ch;
  }

  .valores {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    max-width: 30ch;
  }
  @media (min-width: 700px) {
    .valores {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-8);
      max-width: 54ch;
    }
  }
  /* Entran escalonados con el cruce, no todos de golpe. */
  .valor {
    --aparece: clamp(0, calc(var(--paso, 0) * 7 - var(--orden) * 0.7), 1);
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    font-size: var(--text-h3);
    line-height: 1.25;
    color: #fff;
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    opacity: var(--aparece);
    transform: translateY(calc((1 - var(--aparece)) * 10px));
    transition:
      opacity var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-out);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .acciones :global(.btn[data-variante='secondary']) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
  }
  .acciones :global(.btn[data-variante='secondary']:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
  }
  .acciones :global(.btn[data-variante='primary']) {
    background: #fff;
    color: var(--color-blue-deep);
  }
  .acciones :global(.btn[data-variante='primary']:hover) {
    background: #d6e3f7;
  }

  .seguir {
    position: absolute;
    right: var(--margin-x);
    bottom: var(--space-8);
    z-index: 21;
    display: none;
    width: 44px;
    height: 64px;
    align-items: flex-end;
    justify-content: center;
    opacity: calc(1 - var(--avance, 0) * 4);
  }
  @media (min-width: 900px) {
    .seguir {
      display: flex;
      right: var(--margin-x-lg);
    }
  }
  .seguir-linea {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff);
  }
  .seguir:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
</style>
