---
/* Hero en dos actos, recorrido con el scroll.

   ACTO 1 · DÓNDE — Santiago → Ñuñoa → la avenida → llegar.
   Zoom sobre imágenes de 4096 px. Responde la primera pregunta de cualquiera
   que entra a un sitio de clínica: dónde queda esto.

   ACTO 2 · CÓMO — la consulta y el laboratorio, en video.
   Aparecen los valores de la clínica y los botones. Responde la segunda:
   qué puedo esperar de ustedes.

   ---

   Por qué el acto 1 es zoom en CSS y el acto 2 es video, y no al revés:

   Un zoom es el peor caso para comprimir video —se mueve cada píxel en cada
   fotograma, así que no hay nada que reutilizar— y por eso el acto 1 se veía
   pixelado cuando era video. Hecho con `scale()` sobre imágenes grandes, la GPU
   remuestrea del original y queda nítido en todo el recorrido.

   El acto 2 es lo contrario: cámara fija y movimiento mínimo. Ahí la compresión
   funciona perfecto —los fondos pesan entre 137 y 211 KB— y el movimiento real
   aporta algo que una foto quieta no da.

   ---

   Lo que NO muestra, a propósito:

   El cliente pidió recepcionistas sonriendo "como viendo al personal que te
   atenderá" y un pasillo "con todos operando, para que se vea que la clínica está
   al 100%". No se hizo. La clínica no ha abierto, no hay equipo contratado y el
   espacio no está habilitado: las tres serían afirmaciones falsas sobre el estado
   actual del negocio, no ambientación. Las escenas del acto 2 son anónimas, no se
   presentan como el equipo de Conecta, y ningún texto dice que esté operando.

   Cuando el espacio esté habilitado y haya equipo, se graba de verdad y se
   reemplazan las dos etapas del acto 2. La estructura ya está lista para eso:
   basta cambiar la imagen y el nombre del video en ETAPAS. */
import { Picture } from 'astro:assets';

import santiago from '../../assets/viaje/viaje-1-santiago.png';
import nunoa from '../../assets/viaje/viaje-2-nunoa.png';
import avenida from '../../assets/viaje/calle-nunoa.png';
import edificio from '../../assets/viaje/edificio-nunoa.png';
import consulta from '../../assets/imagenes/c-hero.png';
import laboratorio from '../../assets/imagenes/c-microscopio.png';

interface Props {
  titulo: string;
  bajada: string;
}
const { titulo, bajada } = Astro.props;

/* `de` y `a` son [escala, desplazamientoX %, desplazamientoY %].
   Cada etapa tiene su propio movimiento: un zoom idéntico seis veces se siente
   mecánico. */
const ETAPAS = [
  {
    acto: 1,
    img: santiago,
    alt: 'Vista aérea de Santiago de Chile al atardecer, con la cordillera de los Andes al fondo.',
    rotulo: 'Santiago de Chile',
    de: [1.0, 0, 0],
    a: [1.32, 0, 5],
  },
  {
    acto: 1,
    img: nunoa,
    alt: 'Vista aérea de la comuna de Ñuñoa, con las copas de los plátanos sobre las avenidas.',
    rotulo: 'Comuna de Ñuñoa',
    de: [1.1, 0, -5],
    a: [1.45, 0, 7],
  },
  {
    acto: 1,
    img: avenida,
    alt: 'Avenida residencial de Ñuñoa con plátanos orientales y la cordillera al fondo.',
    rotulo: 'A pasos de Metro Plaza Egaña',
    de: [1.15, 5, 0],
    a: [1.42, -4, 2],
  },
  {
    acto: 1,
    img: edificio,
    alt: 'Edificio de oficinas de fachada clara en Ñuñoa a la hora dorada.',
    rotulo: 'Aquí atendemos',
    de: [1.05, 0, 0],
    a: [1.28, -3, 0],
  },
  {
    acto: 2,
    img: consulta,
    video: 'v-hero',
    alt: 'Consulta médica vista desde atrás: sobre el escritorio, un informe de laboratorio y una mano señalando una línea.',
    de: [1.06, 0, 0],
    a: [1.2, -2, 0],
  },
  {
    acto: 2,
    img: laboratorio,
    video: 'v-compromisos',
    alt: 'Unas manos ajustan el foco de un microscopio de laboratorio sobre un mesón blanco.',
    de: [1.06, 0, 0],
    a: [1.2, 2, 0],
  },
];

/* Los mismos seis valores que se publican en Conócenos. Principio de
   repetición: si el hero dijera otra cosa, serían dos promesas distintas. */
const VALORES = [
  'Excelencia clínica',
  'Atención humanizada',
  'Transparencia en los precios',
  'Confidencialidad',
  'Cercanía',
  'Coordinación',
];

const PRIMER_ACTO_2 = ETAPAS.findIndex((e) => e.acto === 2);
const ROTULOS = ETAPAS.filter((e) => e.acto === 1);
---

<section class="viaje" id="viaje" data-acto2={PRIMER_ACTO_2}>
  <div class="pegado">
    <div class="lienzo">
      {
        ETAPAS.map((e, i) => (
          <div
            class="etapa"
            data-etapa={i}
            data-acto={e.acto}
            style={`--de-s:${e.de[0]};--de-x:${e.de[1]}%;--de-y:${e.de[2]}%;--a-s:${e.a[0]};--a-x:${e.a[1]}%;--a-y:${e.a[2]}%`}
          >
            <Picture
              src={e.img}
              alt={i === 0 ? e.alt : ''}
              widths={[1400, 2000, 2600, 3400, 4096]}
              sizes="160vw"
              formats={['avif', 'webp']}
              loading={i === 0 ? 'eager' : 'lazy'}
              {...(i === 0 ? { fetchpriority: 'high' as const } : {})}
            />
            {e.video && (
              <video
                class="pelicula"
                poster={`/video/${e.video}.jpg`}
                preload="none"
                muted
                loop
                playsinline
                aria-hidden="true"
                data-fuente={e.video}
              />
            )}
          </div>
        ))
      }
      <span class="velo" aria-hidden="true" />
    </div>

    <div class="texto contenedor">
      <div class="acto acto-1">
        <p class="paradas">
          {
            ROTULOS.map((e, i) => (
              <span class="parada" data-parada={i}>
                {e.rotulo}
              </span>
            ))
          }
        </p>
        <h1 class="titular-hero">{titulo}</h1>
        <p class="bajada">{bajada}</p>
      </div>

      <div class="acto acto-2">
        <p class="eyebrow">Cómo atendemos</p>
        <ul class="valores">
          {
            VALORES.map((v, i) => (
              <li class="valor" style={`--orden:${i}`}>
                {v}
              </li>
            ))
          }
        </ul>
        <div class="acciones"><slot /></div>
      </div>
    </div>

    <a class="seguir" href="#como-funciona" aria-label="Bajar al contenido">
      <span class="seguir-linea" aria-hidden="true" />
    </a>
  </div>
</section>

<script>
  const seccion = document.getElementById('viaje');
  if (seccion) {
    const etapas = [...seccion.querySelectorAll<HTMLElement>('.etapa')];
    const paradas = [...seccion.querySelectorAll<HTMLElement>('.parada')];
    const acto1 = seccion.querySelector<HTMLElement>('.acto-1');
    const acto2 = seccion.querySelector<HTMLElement>('.acto-2');
    const total = etapas.length;
    const primerActo2 = Number(seccion.dataset['acto2'] ?? 4);
    const quietud = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conexion = (navigator as { connection?: { saveData?: boolean } }).connection;
    const sinVideo = quietud.matches || Boolean(conexion?.saveData);

    /* Cuánto del recorrido de cada etapa se dedica al cruce con la siguiente. */
    const CRUCE = 0.22;

    const pintar = (avance: number) => {
      const pos = avance * total;

      etapas.forEach((etapa, i) => {
        etapa.style.setProperty('--t', String(Math.min(1, Math.max(0, pos - i))));

        let opacidad = 1;
        if (i > 0 && pos < i) opacidad = Math.max(0, 1 - (i - pos) / CRUCE);
        if (i < total - 1 && pos > i + 1 - CRUCE) opacidad = Math.max(0, (i + 1 - pos) / CRUCE);
        etapa.style.opacity = String(opacidad);
        etapa.style.zIndex = String(opacidad > 0.02 ? 10 + i : 0);

        /* El video de una etapa solo corre cuando esa etapa se está viendo, y no
           se descarga hasta entonces. Fuera de eso queda su póster. */
        const peli = etapa.querySelector<HTMLVideoElement>('.pelicula');
        if (peli && !sinVideo) {
          if (opacidad > 0.35) {
            if (!peli.getAttribute('src')) {
              peli.src = `/video/${peli.dataset['fuente']}.mp4`;
              peli.preload = 'auto';
              peli.addEventListener('playing', () => peli.classList.add('corriendo'));
              for (const ev of ['pause', 'ended', 'error', 'stalled']) {
                peli.addEventListener(ev, () => peli.classList.remove('corriendo'));
              }
            }
            if (peli.paused) peli.play().catch(() => {});
          } else if (!peli.paused) {
            peli.pause();
          }
        }
      });

      /* Rótulo: sigue a la etapa que MÁS se ve, no a la más cercana por
         redondeo, que cambiaba el texto mientras seguías viendo la anterior. */
      let activa = 0;
      let mayor = -1;
      etapas.forEach((etapa, i) => {
        const o = Number(etapa.style.opacity || 0);
        if (o > mayor) {
          mayor = o;
          activa = i;
        }
      });
      paradas.forEach((p, i) => p.classList.toggle('visible', i === activa));

      /* El texto cambia de acto en la misma ventana en que cambia la imagen, así
         el titular no se desvanece sobre un fondo que todavía es del acto 1. */
      const enActo2 = Math.min(1, Math.max(0, (pos - (primerActo2 - CRUCE)) / CRUCE));
      acto1?.style.setProperty('--visible', String(1 - enActo2));
      acto2?.style.setProperty('--visible', String(enActo2));
      acto1?.toggleAttribute('data-activo', enActo2 < 0.5);
      acto2?.toggleAttribute('data-activo', enActo2 >= 0.5);
      seccion.style.setProperty('--acto2-avance', String(enActo2));
      seccion.style.setProperty('--avance', String(avance));
    };

    if (quietud.matches) {
      pintar(0);
    } else {
      let pedido = false;
      const alScrollear = () => {
        if (pedido) return;
        pedido = true;
        requestAnimationFrame(() => {
          pedido = false;
          const caja = seccion.getBoundingClientRect();
          const recorrido = caja.height - window.innerHeight;
          pintar(recorrido <= 0 ? 0 : Math.min(1, Math.max(0, -caja.top / recorrido)));
        });
      };
      addEventListener('scroll', alScrollear, { passive: true });
      addEventListener('resize', alScrollear, { passive: true });
      alScrollear();
    }
  }
</script>

<style>
  .viaje {
    position: relative;
    height: 300svh;
    background: var(--color-blue-deep);
  }
  @media (min-width: 900px) {
    .viaje {
      height: 460svh;
    }
  }

  .pegado {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .lienzo {
    position: absolute;
    inset: 0;
  }

  .etapa {
    position: absolute;
    inset: 0;
    opacity: 0;
    --s: calc(var(--de-s) + (var(--a-s) - var(--de-s)) * var(--t, 0));
    --x: calc(var(--de-x) + (var(--a-x) - var(--de-x)) * var(--t, 0));
    --y: calc(var(--de-y) + (var(--a-y) - var(--de-y)) * var(--t, 0));
    transform: scale(var(--s)) translate3d(var(--x), var(--y), 0);
    transform-origin: center;
    will-change: transform, opacity;
  }
  .etapa:first-child {
    opacity: 1;
  }
  .etapa :global(img),
  .pelicula {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* El video solo tapa la fotografía mientras corre de verdad. Si se pausa por
     lo que sea, reaparece la imagen: nunca un rectángulo liso. */
  .pelicula {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .pelicula:global(.corriendo) {
    opacity: 1;
  }

  .velo {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: var(--velo);
  }

  .texto {
    position: relative;
    z-index: 21;
    display: grid;
    grid-template-areas: 'acto';
    padding-block: var(--space-16);
    color: #fff;
  }
  @media (min-width: 900px) {
    .texto {
      padding-block: var(--space-20) var(--space-24);
    }
  }

  /* Los dos actos ocupan la misma celda y se turnan. Se apilan en vez de
     sucederse para que el bloque no salte de alto al cambiar. */
  .acto {
    grid-area: acto;
    opacity: var(--visible, 0);
    transform: translateY(calc((1 - var(--visible, 0)) * 14px));
    transition:
      opacity var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-out);
  }
  .acto-1 {
    --visible: 1;
  }
  .acto:not([data-activo]) {
    pointer-events: none;
  }

  .paradas {
    display: grid;
    grid-template-areas: 'parada';
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--text-eyebrow-lh);
    letter-spacing: var(--text-eyebrow-ls);
    text-transform: uppercase;
    color: #a9c4e8;
  }
  .parada {
    grid-area: parada;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-out);
  }
  .parada:global(.visible) {
    opacity: 1;
    transform: none;
  }

  .titular-hero {
    margin-top: var(--space-5);
    max-width: 15ch;
    color: #fff;
  }
  .bajada {
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: #dce7f7;
    max-width: 44ch;
  }

  /* ---- Valores del acto 2 ---- */
  .acto-2 .eyebrow {
    color: #a9c4e8;
  }
  .valores {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    max-width: 30ch;
  }
  @media (min-width: 700px) {
    .valores {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-8);
      max-width: 54ch;
    }
  }
  /* Entran escalonados con el avance del acto, no todos de golpe. */
  .valor {
    --aparece: clamp(0, calc(var(--acto2-avance, 0) * 7 - var(--orden) * 0.7), 1);
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    font-size: var(--text-h3);
    line-height: 1.25;
    color: #fff;
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    opacity: var(--aparece);
    transform: translateY(calc((1 - var(--aparece)) * 10px));
    transition:
      opacity var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-out);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .acciones :global(.btn[data-variante='secondary']) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
  }
  .acciones :global(.btn[data-variante='secondary']:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
  }
  .acciones :global(.btn[data-variante='primary']) {
    background: #fff;
    color: var(--color-blue-deep);
  }
  .acciones :global(.btn[data-variante='primary']:hover) {
    background: #d6e3f7;
  }

  .seguir {
    position: absolute;
    right: var(--margin-x);
    bottom: var(--space-8);
    z-index: 21;
    display: none;
    width: 44px;
    height: 64px;
    align-items: flex-end;
    justify-content: center;
    opacity: calc(1 - var(--avance, 0) * 4);
  }
  @media (min-width: 900px) {
    .seguir {
      display: flex;
      right: var(--margin-x-lg);
    }
  }
  .seguir-linea {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff);
  }
  .seguir:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
</style>
