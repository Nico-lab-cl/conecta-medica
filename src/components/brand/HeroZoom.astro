---
/* Hero del viaje, versión nítida: Santiago → Ñuñoa → la avenida → llegar.

   Reemplaza a la versión en video, que se veía pixelada. La razón de fondo:

   Un zoom es el peor caso posible para comprimir video. La compresión guarda lo
   que NO cambia entre fotogramas, y en un zoom continuo se mueve cada píxel en
   cada fotograma. Encima, recorrer el video con el scroll obliga a un fotograma
   clave cada 8, y cada uno es una imagen completa. Todo el bitrate se va ahí.
   Para que ese viaje se viera nítido a 1080p harían falta entre 20 y 35 MB.

   Un zoom, en el fondo, es una transformación geométrica: `scale()`. Antes yo la
   horneaba en píxeles y después comprimía mal esos píxeles. Acá la hace el
   navegador sobre imágenes de 4096 px, así que la GPU remuestrea desde el
   original completo en cada paso del recorrido: nítido en todos los puntos,
   siempre, y con menos peso que el video que reemplaza.

   Lo que se pierde es el movimiento orgánico —las hojas, la calima—. En los
   planos aéreos no se nota; una ciudad desde el aire ya está casi inmóvil.

   Cada plano tiene su propio encuadre de origen y de destino. La cámara no hace
   siempre lo mismo: sobre Santiago avanza hacia la cordillera, sobre Ñuñoa
   desciende, en la avenida entra caminando, y en el último se acerca al edificio.
   Un zoom idéntico cuatro veces se siente mecánico. */
import { Picture } from 'astro:assets';

import santiago from '../../assets/viaje/viaje-1-santiago.png';
import nunoa from '../../assets/viaje/viaje-2-nunoa.png';
import avenida from '../../assets/viaje/calle-nunoa.png';
import edificio from '../../assets/viaje/edificio-nunoa.png';

interface Props {
  titulo: string;
  bajada: string;
}
const { titulo, bajada } = Astro.props;

/* Cada etapa: su imagen, su rótulo, y el movimiento de cámara.
   `de` y `a` son [escala, desplazamientoX %, desplazamientoY %]. */
const ETAPAS = [
  {
    img: santiago,
    alt: 'Vista aérea de Santiago de Chile al atardecer, con la cordillera de los Andes al fondo.',
    rotulo: 'Santiago de Chile',
    de: [1.0, 0, 0],
    a: [1.35, 0, 6],
  },
  {
    img: nunoa,
    alt: 'Vista aérea de la comuna de Ñuñoa, con las copas de los plátanos sobre las avenidas.',
    rotulo: 'Comuna de Ñuñoa',
    de: [1.1, 0, -6],
    a: [1.5, 0, 8],
  },
  {
    img: avenida,
    alt: 'Avenida residencial de Ñuñoa con plátanos orientales y la cordillera al fondo.',
    rotulo: 'A pasos de Metro Plaza Egaña',
    de: [1.15, 6, 0],
    a: [1.45, -4, 2],
  },
  {
    img: edificio,
    alt: 'Edificio de oficinas de fachada clara en Ñuñoa a la hora dorada.',
    rotulo: 'Aquí atendemos',
    de: [1.05, 0, 0],
    a: [1.3, -3, 0],
  },
];
---

<section class="viaje" id="viaje" style={`--etapas:${ETAPAS.length}`}>
  <div class="pegado">
    <div class="lienzo">
      {
        ETAPAS.map((e, i) => (
          <div
            class="etapa"
            data-etapa={i}
            style={`--de-s:${e.de[0]};--de-x:${e.de[1]}%;--de-y:${e.de[2]}%;--a-s:${e.a[0]};--a-x:${e.a[1]}%;--a-y:${e.a[2]}%`}
          >
            <Picture
              src={e.img}
              alt={i === 0 ? e.alt : ''}
              widths={[1400, 2000, 2600, 3400, 4096]}
              {/* 160vw, no 100vw.

                  `sizes` le dice al navegador cuántos píxeles va a necesitar. Si
                  se le declara 100vw pide una imagen del ancho de la pantalla,
                  pero el zoom la amplía hasta 1,5×: en el punto de máximo
                  acercamiento estaría estirando 1440 px para llenar 2160, y se
                  vería exactamente igual de blanda que el video que reemplazó.
                  160vw cubre el zoom máximo con margen. */}
              sizes="160vw"
              formats={['avif', 'webp']}
              loading={i === 0 ? 'eager' : 'lazy'}
              {...(i === 0 ? { fetchpriority: 'high' as const } : {})}
            />
          </div>
        ))
      }
      <span class="velo" aria-hidden="true" />
    </div>

    <div class="texto contenedor">
      <p class="paradas">
        {
          ETAPAS.map((e, i) => (
            <span class="parada" data-parada={i}>
              {e.rotulo}
            </span>
          ))
        }
      </p>

      <h1 class="titular-hero">{titulo}</h1>
      <p class="bajada">{bajada}</p>
      <div class="acciones"><slot /></div>
    </div>

    <a class="seguir" href="#como-funciona" aria-label="Bajar al contenido">
      <span class="seguir-linea" aria-hidden="true" />
    </a>
  </div>
</section>

<script>
  /* El scroll mueve el viaje. Todo el trabajo por cuadro es escribir dos
     propiedades CSS por etapa; la GPU hace el resto. No hay decodificación de
     video, así que no hay nada que se pueda trabar. */
  const seccion = document.getElementById('viaje');
  if (seccion) {
    const etapas = [...seccion.querySelectorAll<HTMLElement>('.etapa')];
    const paradas = [...seccion.querySelectorAll<HTMLElement>('.parada')];
    const total = etapas.length;
    const quietud = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Cuánto del recorrido de cada etapa se dedica al cruce con la siguiente. */
    const CRUCE = 0.22;

    const pintar = (avance: number) => {
      /* Posición dentro del viaje completo, en unidades de etapa: 0 es el
         comienzo del primer plano y `total` el final del último.

         Antes esto llegaba solo a (total - 1 + CRUCE), y el resultado era que la
         última etapa alcanzaba a completar apenas un 22% de su movimiento de
         cámara: el viaje terminaba a medio acercarse al edificio. */
      const pos = avance * total;

      etapas.forEach((etapa, i) => {
        /* Avance interno de esta etapa, de 0 a 1. */
        const propio = Math.min(1, Math.max(0, pos - i));
        etapa.style.setProperty('--t', String(propio));

        /* Opacidad: entra durante el cruce con la anterior, sale durante el
           cruce con la siguiente. La primera nunca se desvanece por arriba. */
        let opacidad = 1;
        if (i > 0 && pos < i) opacidad = Math.max(0, 1 - (i - pos) / CRUCE);
        if (i < total - 1 && pos > i + 1 - CRUCE) opacidad = Math.max(0, (i + 1 - pos) / CRUCE);
        etapa.style.opacity = String(opacidad);
        etapa.style.zIndex = String(opacidad > 0.02 ? 10 + i : 0);
      });

      /* El rótulo sigue a la etapa que MÁS se ve, no a la más cercana por
         redondeo. Con redondeo el texto cambiaba a mitad de camino, cuando la
         imagen anterior todavía estaba entera en pantalla: se leía "Ñuñoa"
         mientras seguías viendo Santiago. */
      let activa = 0;
      let mayor = -1;
      etapas.forEach((etapa, i) => {
        const o = Number(etapa.style.opacity || 0);
        if (o > mayor) {
          mayor = o;
          activa = i;
        }
      });
      paradas.forEach((p, i) => p.classList.toggle('visible', i === activa));
      seccion.style.setProperty('--avance', String(avance));
    };

    if (quietud.matches) {
      /* Sin movimiento: se queda el primer plano, la vista de Santiago. */
      pintar(0);
    } else {
      let pedido = false;
      const alScrollear = () => {
        if (pedido) return;
        pedido = true;
        requestAnimationFrame(() => {
          pedido = false;
          const caja = seccion.getBoundingClientRect();
          const recorrido = caja.height - window.innerHeight;
          pintar(recorrido <= 0 ? 0 : Math.min(1, Math.max(0, -caja.top / recorrido)));
        });
      };
      addEventListener('scroll', alScrollear, { passive: true });
      addEventListener('resize', alScrollear, { passive: true });
      alScrollear();
    }
  }
</script>

<style>
  /* La altura del contenedor es la distancia de scroll que dura el viaje.
     En móvil se acorta: el mismo recorrido en menos scroll, porque en una
     pantalla de teléfono cuatro pantallas de viaje se hacen eternas. */
  .viaje {
    position: relative;
    height: 240svh;
    background: var(--color-blue-deep);
  }
  @media (min-width: 900px) {
    .viaje {
      height: 340svh;
    }
  }

  .pegado {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .lienzo {
    position: absolute;
    inset: 0;
  }

  .etapa {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* La interpolación entre el encuadre de origen y el de destino se hace en
       CSS con --t, así el JavaScript solo escribe un número por etapa. */
    --s: calc(var(--de-s) + (var(--a-s) - var(--de-s)) * var(--t, 0));
    --x: calc(var(--de-x) + (var(--a-x) - var(--de-x)) * var(--t, 0));
    --y: calc(var(--de-y) + (var(--a-y) - var(--de-y)) * var(--t, 0));
    transform: scale(var(--s)) translate3d(var(--x), var(--y), 0);
    transform-origin: center;
    will-change: transform, opacity;
  }
  .etapa:first-child {
    opacity: 1;
  }
  .etapa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .velo {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: var(--velo);
  }

  .texto {
    position: relative;
    z-index: 21;
    padding-block: var(--space-16);
    color: #fff;
  }
  @media (min-width: 900px) {
    .texto {
      padding-block: var(--space-20) var(--space-24);
    }
  }

  .paradas {
    display: grid;
    grid-template-areas: 'parada';
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--text-eyebrow-lh);
    letter-spacing: var(--text-eyebrow-ls);
    text-transform: uppercase;
    color: #a9c4e8;
  }
  .parada {
    grid-area: parada;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--dur-mid) var(--ease-out),
      transform var(--dur-mid) var(--ease-out);
  }
  .parada:global(.visible) {
    opacity: 1;
    transform: none;
  }

  .titular-hero {
    margin-top: var(--space-5);
    max-width: 15ch;
    color: #fff;
  }
  .bajada {
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: #dce7f7;
    max-width: 44ch;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .acciones :global(.btn[data-variante='secondary']) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
  }
  .acciones :global(.btn[data-variante='secondary']:hover) {
    background: rgba(255, 255, 255, 0.18);
    border-color: #fff;
  }
  .acciones :global(.btn[data-variante='primary']) {
    background: #fff;
    color: var(--color-blue-deep);
  }
  .acciones :global(.btn[data-variante='primary']:hover) {
    background: #d6e3f7;
  }

  .seguir {
    position: absolute;
    right: var(--margin-x);
    bottom: var(--space-8);
    z-index: 21;
    display: none;
    width: 44px;
    height: 64px;
    align-items: flex-end;
    justify-content: center;
    opacity: calc(1 - var(--avance, 0) * 3);
  }
  @media (min-width: 900px) {
    .seguir {
      display: flex;
      right: var(--margin-x-lg);
    }
  }
  .seguir-linea {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff);
  }
  .seguir:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
</style>
