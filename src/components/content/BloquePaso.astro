---
/* Paso numerado. Portado de StepBlock.jsx.
   La numeración es información real: es la secuencia de la atención. */
interface Props { numero: number; titulo: string; activo?: boolean }
const { numero, titulo, activo = true } = Astro.props;
---
<div class="paso" data-activo={activo ? 'si' : 'no'}>
  <span class="num">{String(numero).padStart(2, '0')}</span>
  <h3>{titulo}</h3>
  <p><slot /></p>
</div>
<style>
  .paso { display: flex; flex-direction: column; gap: 12px; }
  .num {
    width: 44px; height: 44px; border-radius: var(--radius-pill);
    border: var(--border-width-emph) solid var(--thread-stroke-muted);
    background: var(--color-white); display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 18px; font-weight: var(--weight-medium);
    color: var(--color-gray);
  }
  .paso[data-activo='si'] .num { border-color: var(--color-blue); color: var(--color-blue); }
  .paso h3 {
    margin: 0; font-family: var(--font-serif); font-weight: var(--weight-semibold);
    font-size: var(--text-h3); line-height: 1.3; color: var(--color-blue);
  }
  .paso p {
    margin: 0; font-size: var(--text-body); line-height: 1.6;
    color: var(--color-ink); max-width: 38ch;
  }
</style>
