---
/* Cabecera. Portado de design-system/components/navigation/SiteHeader.jsx.

   Dos cambios respecto del original:
   1. Las rutas del design system (/hematologia, /pacientes) se reemplazan por las
      del brief, que son las que se posicionan (/conecta-hematologia/,
      /informacion-para-pacientes/). Ver docs/00-plan.md §5.
   2. El menú móvil NO es una isla de React. Montar React para alternar un
      atributo cuesta ~40 KB comprimidos; este script son 12 líneas y no
      necesita hidratación. El presupuesto de 60 KB es un criterio de
      aceptación, no una aspiración.

   El estado `compressed` del design system (80px → 64px al hacer scroll) se
   resuelve con IntersectionObserver sobre un centinela, sin escuchar scroll. */
import Logo from '../brand/Logo.astro';
import BotonAgendar from '../actions/BotonAgendar.astro';
import Icono from '../core/Icono.astro';
import { RUTAS } from '../../lib/rutas';
import {
  ajustes,
  precioCLP,
  hayDirectorioDeEquipo,
} from '../../lib/contenido';

interface Props {
  actual?: string;
  /* La portada abre con un hero a pantalla completa. La cabecera se monta
     ENCIMA de esa imagen, transparente y en blanco, y se vuelve sólida al
     pasar el hero. Es lo que hace que el hero se sienta de borde a borde en
     vez de empezar debajo de una barra. */
  sobreHero?: boolean;
}
const { actual = '', sobreHero = false } = Astro.props;

const a = await ajustes();
const conEquipo = await hayDirectorioDeEquipo();

/* Menú definido por el cliente. Seis ítems fijos, en su orden.

   Dos notas sobre lo que cambió respecto del menú anterior:

   - "Inicio" es redundante con el logo, que ya lleva a la portada. Va porque el
     cliente lo pidió explícitamente, y en salud es un ítem que el público mayor
     sí busca.
   - "Agendar hora" repite el botón de acción de la derecha. Se mantienen los
     dos: el botón convierte, el ítem de menú da la ruta a quien lee el menú
     antes de mirar los botones.

   "Equipo médico" existe desde un solo profesional. Ver hayDirectorioDeEquipo()
   en lib/contenido.ts y la advertencia sobre los datos que faltan. */
const items = [
  { label: 'Inicio', href: RUTAS.inicio },
  { label: 'Quiénes somos', href: RUTAS.conocenos },
  { label: 'Agendar hora', href: RUTAS.agendar },
  { label: 'Preguntas frecuentes', href: RUTAS.preguntas },
  { label: 'Contacto', href: RUTAS.contacto },
  ...(conEquipo ? [{ label: 'Equipo médico', href: RUTAS.equipo }] : []),
];

/* El menú móvil lleva los mismos seis, más los destinos que no entran arriba
   pero que sí conviene alcanzar desde el panel: la unidad clínica, sus precios
   y la telemedicina. En móvil no hay problema de ancho. */
const itemsMovil = [
  ...items,
  { label: 'Conecta Hematología', href: RUTAS.unidad },
  { label: 'Telemedicina', href: RUTAS.telemedicina },
  { label: 'Precios', href: RUTAS.precios },
];
---

<span id="centinela-cabecera" data-sobre-hero={sobreHero ? 'si' : undefined} aria-hidden="true"></span>

<header class="cabecera" id="cabecera" data-sobre-hero={sobreHero ? 'si' : undefined}>
  <div class="barra contenedor">
    <a class="marca" href={RUTAS.inicio} aria-label="Clínica Conecta, inicio">
      <Logo variante="lockup" alto={40} clase="marca-color" />
      {sobreHero && <Logo variante="lockup" alto={40} tono="blanco" clase="marca-blanca" />}
    </a>

    <nav class="nav-escritorio" aria-label="Principal">
      {
        items.map((it) => (
          <a
            class="nav-item"
            href={it.href}
            aria-current={actual === it.href ? 'page' : undefined}
          >
            {it.label}
          </a>
        ))
      }
    </nav>

    <div class="acciones">
      <div class="solo-escritorio"><BotonAgendar tam="md" /></div>
      <div class="solo-movil"><BotonAgendar tam="sm" conIcono={false} /></div>
      <button
        class="hamburguesa"
        id="btn-menu"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <Icono nombre="menu" tam={24} clase="icono-abrir" />
        <Icono nombre="x" tam={24} clase="icono-cerrar" />
      </button>
    </div>
  </div>

  <div class="menu-movil" id="menu-movil" hidden>
    <nav class="contenedor" aria-label="Principal">
      {
        itemsMovil.map((it) => (
          <a
            class="movil-item"
            href={it.href}
            aria-current={actual === it.href ? 'page' : undefined}
          >
            {it.label}
          </a>
        ))
      }
      <div class="movil-cta"><BotonAgendar tam="md" anchoCompleto /></div>
      <p class="movil-nota">
        Atención solo particular · consulta {precioCLP(a.precioConsulta)}
      </p>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-movil');
  btn?.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    btn.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    if (menu) menu.hidden = abierto;
  });

  // Compresión de la cabecera sin escuchar scroll.
  const centinela = document.getElementById('centinela-cabecera');
  const cabecera = document.getElementById('cabecera');
  if (centinela && cabecera && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([e]) => cabecera.toggleAttribute('data-comprimida', !e?.isIntersecting),
      { rootMargin: '0px' },
    ).observe(centinela);
  }
</script>

<style>
  #centinela-cabecera {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }
  /* Con hero a pantalla completa, el centinela se corre casi hasta el final del
     hero: la cabecera recién se vuelve sólida cuando el titular ya salió. */
  #centinela-cabecera[data-sobre-hero] {
    top: 78svh;
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-white);
    border-bottom: var(--border-width) solid var(--color-line);
    transition:
      background-color var(--dur-mid) var(--ease-standard),
      border-color var(--dur-mid) var(--ease-standard),
      box-shadow var(--dur-mid) var(--ease-standard);
  }
  .cabecera[data-comprimida] {
    border-bottom-color: transparent;
    box-shadow: var(--shadow-1);
  }

  /* ---- Cabecera montada sobre el hero ---- */
  .cabecera[data-sobre-hero] {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
  }
  .cabecera[data-sobre-hero]:not([data-comprimida]) {
    box-shadow: none;
  }
  .cabecera[data-sobre-hero][data-comprimida] {
    background: var(--color-white);
  }

  .marca :global(.marca-blanca) {
    display: none;
  }
  .cabecera[data-sobre-hero]:not([data-comprimida]) .marca :global(.marca-color) {
    display: none;
  }
  .cabecera[data-sobre-hero]:not([data-comprimida]) .marca :global(.marca-blanca) {
    display: block;
  }
  .cabecera[data-sobre-hero]:not([data-comprimida]) .nav-item,
  .cabecera[data-sobre-hero]:not([data-comprimida]) .hamburguesa {
    color: #fff;
  }
  .cabecera[data-sobre-hero]:not([data-comprimida]) .nav-item:hover {
    color: #d6e3f7;
  }
  .cabecera[data-sobre-hero]:not([data-comprimida]) .nav-item[aria-current='page']::after {
    background: #fff;
  }

  .barra {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    transition: height var(--dur-mid) var(--ease-standard);
  }
  .cabecera[data-comprimida] .barra {
    height: 64px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
  }

  .nav-escritorio {
    display: none;
    align-items: center;
    gap: 20px;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  .nav-item {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    text-decoration: none;
    padding: 6px 0;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-item:hover {
    color: var(--color-blue);
  }
  .nav-item:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .nav-item[aria-current='page'] {
    color: var(--color-blue);
  }
  .nav-item[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: var(--border-width-emph);
    background: var(--color-blue);
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .solo-escritorio {
    display: none;
  }
  .solo-movil {
    display: block;
  }

  .hamburguesa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-min);
    height: var(--touch-min);
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-ink);
  }
  .hamburguesa:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-sm);
  }
  .hamburguesa :global(.icono-cerrar) {
    display: none;
  }
  .hamburguesa[aria-expanded='true'] :global(.icono-abrir) {
    display: none;
  }
  .hamburguesa[aria-expanded='true'] :global(.icono-cerrar) {
    display: inline-block;
  }

  .menu-movil {
    border-top: var(--border-width) solid var(--color-line);
    box-shadow: var(--shadow-2);
    padding-block: 8px 24px;
    background: var(--color-white);
  }
  .movil-item {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: var(--border-width) solid var(--color-line);
  }
  .movil-item[aria-current='page'] {
    color: var(--color-blue);
  }
  .movil-cta {
    margin-top: 20px;
  }
  .movil-nota {
    margin-top: 12px;
    font-size: var(--text-body-sm);
    color: var(--color-gray);
  }

  @media (min-width: 1100px) {
    .nav-escritorio {
      display: flex;
    }
    .solo-escritorio {
      display: block;
    }
    .solo-movil,
    .hamburguesa,
    .menu-movil {
      display: none;
    }
  }
</style>
