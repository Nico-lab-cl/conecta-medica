---
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import Icono from '../../components/core/Icono.astro';
import BloquePaso from '../../components/content/BloquePaso.astro';
import Hilo from '../../components/brand/Hilo.astro';
import NotaInfo from '../../components/notices/NotaInfo.astro';
import AvisoUrgencias from '../../components/notices/AvisoUrgencias.astro';
import BotonAgendar from '../../components/actions/BotonAgendar.astro';
import BotonWhatsApp from '../../components/actions/BotonWhatsApp.astro';
import { RUTAS, migas } from '../../lib/rutas';
import { leerPagina, propsCabecera } from '../../lib/paginas';

const ruta = migas({ label: 'Telemedicina' });

const P = await leerPagina('paginaTelemedicina', 'telemedicina');
const cab = await propsCabecera(P, { foto: FOTO_PAGINA.telemedicina, og: '/og/telemedicina.jpg' });
---

<Pagina
  {...cab}
  ruta={RUTAS.telemedicina}
  actual={RUTAS.telemedicina}
  migas={ruta}
>

  <section class="seccion">
    <div class="contenedor dos">
      <div>
        <h2>{P.si.titulo}</h2>
        <ul class="lista">
          {
            P.si.items.map((i) => (
              <li>
                <Icono nombre="check" tam={20} color="var(--color-blue)" />
                {i}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>{P.no.titulo}</h2>
        <ul class="lista tenue">
          {
            P.no.items.map((i) => (
              <li>
                <Icono nombre="minus" tam={20} color="var(--color-gray)" />
                {i}
              </li>
            ))
          }
        </ul>
        <div class="aviso-cambio">
          <NotaInfo titulo={P.notaPresencial.titulo}>{P.notaPresencial.texto}</NotaInfo>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor">
      <p class="eyebrow">{P.pasos.eyebrow}</p>
      <h2>{P.pasos.titulo}</h2>
      <div class="hilo" aria-hidden="true"><Hilo nodos={P.pasos.items.length} /></div>
      <ol class="pasos">
        {
          P.pasos.items.map((p, i) => (
            <li>
              <BloquePaso numero={i + 1} titulo={p.titulo}>
                {p.texto}
              </BloquePaso>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor prosa">
      <h2>{P.regiones.titulo}</h2>
      {P.regiones.parrafos.map((t) => <p class="parrafo">{t}</p>)}

      <div class="pendiente">
        <NotaInfo titulo={P.notaPlataforma.titulo}>{P.notaPlataforma.texto}</NotaInfo>
      </div>

      <div class="urgencias"><AvisoUrgencias /></div>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor cierre">
      <h2>{P.cierre.titulo}</h2>
      <p>{P.cierre.texto}</p>
      <div class="acciones">
        <BotonAgendar tam="lg" />
        <BotonWhatsApp origen="telemedicina" />
      </div>
    </div>
  </section>
</Pagina>

<style>
  .dos {
    display: grid;
    gap: var(--space-10);
  }
  @media (min-width: 900px) {
    .dos {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
  .lista {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .lista li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .lista.tenue li {
    color: var(--color-gray);
  }
  .aviso-cambio {
    margin-top: var(--space-8);
  }
  .hilo {
    margin-block: var(--space-10) var(--space-8);
    display: none;
  }
  @media (min-width: 900px) {
    .hilo {
      display: block;
    }
  }
  .pasos {
    display: grid;
    gap: var(--space-10);
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
  }
  @media (min-width: 900px) {
    .pasos {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
      margin-top: var(--space-6);
    }
  }
  .parrafo {
    margin-top: var(--space-5);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  .pendiente,
  .urgencias {
    margin-top: var(--space-10);
  }
  .cierre p {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-gray);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
