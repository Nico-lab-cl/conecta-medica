---
/* Conócenos.

   Orden deliberado: primero el médico y su formación verificable, después el
   proyecto, y al final misión, visión y valores. Para una clínica de un solo
   médico, abrir con "misión y visión" es relleno corporativo; lo que el
   paciente quiere saber es quién lo va a atender. Ver docs/00-plan.md §5.3.

   De los 14 valores del brief se publican 6: listar 14 diluye el mensaje. */
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import Icono from '../../components/core/Icono.astro';
import Cita from '../../components/content/Cita.astro';
import NotaInfo from '../../components/notices/NotaInfo.astro';
import BotonAgendar from '../../components/actions/BotonAgendar.astro';
import EnlaceTexto from '../../components/actions/EnlaceTexto.astro';
import { RUTAS, migas } from '../../lib/rutas';
import { leerPagina, propsCabecera } from '../../lib/paginas';
import { profesionalesActivos, ajustes } from '../../lib/contenido';
import { medicoJsonLd } from '../../lib/schema';

const a = await ajustes();
const profesionales = await profesionalesActivos();
const fundador = profesionales.find((p) => p.data.slug === 'carlos-flores-angulo');
/* El cuerpo del .mdx es la biografía larga. Hasta ahora sólo se renderizaba en
   /equipo/[slug]/, así que Conócenos —que es donde el paciente va a leer quién
   lo atiende— mostraba únicamente la línea corta de `bio`. */
const Biografia = fundador ? (await render(fundador)).Content : null;
const ruta = migas({ label: 'Conócenos' });
const sitio = Astro.site?.toString() ?? 'https://conectamedica.com/';

const P = await leerPagina('paginaConocenos', 'conocenos');
const cab = await propsCabecera(P, { foto: FOTO_PAGINA.conocenos, og: '/og/conocenos.jpg' });
---

<Pagina
  {...cab}
  ruta={RUTAS.conocenos}
  actual={RUTAS.conocenos}
  migas={ruta}
  jsonLd={fundador
    ? [medicoJsonLd(fundador.data, new URL(RUTAS.conocenos, sitio).toString(), sitio)]
    : []}
>

  {
    fundador && (
      <section class="seccion">
        <div class="contenedor perfil">
          <div class="retrato">
            {fundador.data.foto ? (
              <Picture
                src={fundador.data.foto}
                alt={`Retrato de ${fundador.data.nombreCompleto}`}
                widths={[320, 640, 960]}
                sizes="(min-width: 900px) 320px, 80vw"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="eager"
              />
            ) : (
              <span class="monograma" aria-hidden="true">CF</span>
            )}
          </div>

          <div class="perfil-texto">
            <p class="eyebrow">{P.quienAtiende}</p>
            <h2>{fundador.data.nombreCompleto}</h2>
            <p class="rol">{fundador.data.especialidad}</p>
            <div class="bio">{Biografia ? <Biografia /> : <p>{fundador.data.bio}</p>}</div>

            {fundador.data.formacion.length > 0 ? (
              <>
                <h3 class="sub">Formación</h3>
                <ul class="formacion">
                  {fundador.data.formacion.map((f) => (
                    <li>
                      <Icono nombre="check" tam={18} color="var(--color-blue)" />
                      <span>
                        <b>{f.titulo}</b>
                        {f.institucion && <> · {f.institucion}</>}
                        {f.anio && <> · {f.anio}</>}
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <div class="pendiente">
                <NotaInfo titulo="Formación y credenciales">
                  Estamos completando esta sección con los títulos, instituciones y el número de
                  registro en la Superintendencia de Salud. Preferimos dejarla vacía antes que
                  publicar datos aproximados.
                </NotaInfo>
              </div>
            )}

            {fundador.data.registroSuperintendencia && (
              <p class="registro">
                Registro Nacional de Prestadores Individuales de Salud:{' '}
                <b>{fundador.data.registroSuperintendencia}</b>.{' '}
                <EnlaceTexto
                  href="https://rnpi.superdesalud.gob.cl/"
                  externo
                >
                  Verificar en la Superintendencia
                </EnlaceTexto>
              </p>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="seccion seccion-alt">
    <div class="contenedor prosa">
      <p class="eyebrow">{P.porque.eyebrow}</p>
      <h2>{P.porque.titulo}</h2>
      {P.porque.parrafos.map((t) => <p class="parrafo">{t}</p>)}

      <div class="escritorio">
      </div>

      {P.porque.cita && <Cita fuente={P.porque.citaFuente}>{P.porque.cita}</Cita>}

      {P.porque.parrafosDespues.map((t) => <p class="parrafo">{t}</p>)}
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <p class="eyebrow">{P.valores.eyebrow}</p>
      <h2>{P.valores.titulo}</h2>
      <ul class="valores">
        {
          P.valores.items.map((v) => (
            <li>
              <Icono nombre={v.icono} tam={24} color="var(--color-blue)" />
              <div>
                <p class="valor-t">{v.titulo}</p>
                <p class="valor-d">{v.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor cierre">
      <p class="eyebrow">{P.compromisosEyebrow}</p>
      <ul class="compromisos">
        {a.compromisos.map((c) => <li><Icono nombre="check" tam={20} color="var(--color-blue)" />{c}</li>)}
      </ul>
      <div class="acciones"><BotonAgendar tam="lg" /></div>
    </div>
  </section>
</Pagina>

<style>
  .perfil {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 900px) {
    .perfil {
      grid-template-columns: 320px 1fr;
      gap: var(--space-16);
      align-items: start;
    }
  }
  .retrato {
    background: var(--surface-alt);
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    max-width: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .retrato :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El recorte de 4:5 sobre una foto de 3:4 sobra 27 px de alto. Centrado, se
       llevaría la mitad de arriba, y la coronilla está a 13 px del borde: con
       eso queda rapado. Anclado arriba, lo que sobra se corta abajo. */
    object-position: 50% 0%;
  }
  .monograma {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: var(--weight-semibold);
    color: var(--color-blue);
  }
  .rol {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-blue);
  }
  /* Antes era un <p>; ahora envuelve los párrafos que vienen del .mdx, así que
     el estilo baja a los hijos y el bloque sólo pone el margen y la medida. */
  .bio {
    margin-top: var(--space-5);
    max-width: var(--measure-prose);
  }
  .bio :global(p) {
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }
  .bio :global(p + p) {
    margin-top: var(--space-4);
  }
  .sub {
    margin-top: var(--space-10);
  }
  .formacion {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .formacion li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .pendiente,
  .registro {
    margin-top: var(--space-8);
  }
  .registro {
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--color-gray);
  }
  .escritorio {
    margin: var(--space-10) 0 0;
  }
  .escritorio :global(.banda) {
    padding-inline: 0;
    max-width: none;
  }
  .parrafo {
    margin-top: var(--space-5);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  .valores {
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 700px) {
    .valores {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .valores {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .valores li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .valor-t {
    font-weight: var(--weight-semibold);
    font-size: var(--text-body);
    color: var(--color-ink);
  }
  .valor-d {
    margin-top: var(--space-1);
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--color-gray);
  }
  .compromisos {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-body-lg);
    line-height: 1.5;
  }
  @media (min-width: 700px) {
    .compromisos {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  .compromisos li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    color: var(--color-blue-deep);
  }
  .acciones {
    margin-top: var(--space-10);
  }
</style>
