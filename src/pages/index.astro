---
/* Portada.

   Reescrita después de contrastarla con laverocktx.com, que el cliente puso
   como referencia. Cuatro cambios estructurales respecto de la versión anterior:

   1. El hero es la fotografía a pantalla completa con el titular encima, no
      texto sobre blanco con una imagen debajo.
   2. El ritmo alterna tres superficies —blanco, azul nube, azul profundo— en vez
      de blanco sobre blanco todo el camino.
   3. "El problema" pasa a ser un bloque oscuro de declaración, no tres párrafos
      sueltos: es el momento de mayor peso narrativo de la página.
   4. Los cuatro pasos usan un gráfico fijo mientras la lista scrollea al lado,
      como en la referencia.
*/
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroZoom from '../components/brand/HeroZoom.astro';
import Hilo from '../components/brand/Hilo.astro';
import SeccionMedia from '../components/content/SeccionMedia.astro';
import BotonAgendar from '../components/actions/BotonAgendar.astro';
import Boton from '../components/actions/Boton.astro';
import Chip from '../components/content/Chip.astro';
import TarjetaPrestacion from '../components/content/TarjetaPrestacion.astro';
import Acordeon from '../components/content/Acordeon.astro';
import Icono from '../components/core/Icono.astro';
import { RUTAS } from '../lib/rutas';
import {
  ajustes,
  pais,
  serviciosActivos,
  faqsDestacadas,
  horarioLegible,
  precioCLP,
} from '../lib/contenido';
import { faqJsonLd } from '../lib/schema';
import { FOTO_PRESTACION, fotoDePrestacion, FOTO_PAGINA } from '../lib/imagenes';

const a = await ajustes();
const cl = (await pais('cl')).data;
const servicios = await serviciosActivos();
const destacadas = await faqsDestacadas(4);

const PASOS = [
  {
    titulo: 'Solicitas tu hora',
    texto: 'Por el formulario o por WhatsApp. Te confirmamos día y hora por el canal que prefieras.',
  },
  {
    titulo: 'Te evaluamos con tiempo',
    texto:
      'Revisamos tu historia completa y los exámenes que traigas, incluidos los antiguos. No partimos de cero.',
  },
  {
    titulo: 'Estudiamos y te explicamos',
    texto:
      'Definimos qué falta estudiar y en qué orden, y te explicamos el plan en palabras que se entienden.',
  },
  {
    titulo: 'Coordinamos si hace falta',
    texto:
      'Si tu caso necesita otra mirada, la coordinamos nosotros. No tienes que armar el recorrido por tu cuenta.',
  },
];

const faqItems = destacadas.map((f) => ({
  q: f.data.pregunta,
  a: f.data.respuestaCorta.trim(),
  href: `${RUTAS.preguntas}#${f.data.slug}`,
}));
---

<Base
  titulo="Hematólogo en Ñuñoa y telemedicina — Clínica Conecta"
  descripcion="Atención hematológica coordinada en Ñuñoa y por telemedicina en todo Chile. Consulta particular $50.000. Atención de sábado."
  ruta={RUTAS.inicio}
  actual={RUTAS.inicio}
  imagenOg="/og/inicio.jpg"
  heroSuelto
  jsonLd={destacadas.length ? [faqJsonLd(destacadas.map((f) => f.data))] : []}
>
  <HeroZoom
    titulo="Atención hematológica coordinada."
    bajada={`${a.tagline}. Presencial en Ñuñoa y por telemedicina en todo Chile.`}
  >
    <BotonAgendar tam="lg" />
    <Boton href="#como-funciona" variante="secondary" tam="lg" icono="arrow-right">
      Cómo funciona la atención
    </Boton>
  </HeroZoom>

  {/* Principio de proximidad: esta barra pertenece al hero, no es una sección
      aparte. Antes era una franja blanca flotando entre el hero y "el problema",
      sin pertenecer a ninguno de los dos. Ahora cierra el hero: mismo fondo,
      misma tinta, sin borde que la separe de arriba. */}
  <section class="datos seccion-oscura">
    <div class="contenedor datos-fila">
      <span><Chip tipo="telemedicina" etiqueta="Telemedicina en todo Chile" /></span>
      <span><Chip tipo="presencial" etiqueta={`Consulta ${precioCLP(a.precioConsulta)}`} /></span>
      <span><Chip tipo="sabado" etiqueta="Atención de sábado" /></span>
      <span class="sin-derivacion">Sin derivación previa</span>
    </div>
  </section>

  <!-- ===================== EL PROBLEMA, en oscuro ===================== -->
  <SeccionMedia video="v-problema" clase="seccion seccion-oscura problema">
    <div class="contenedor">
      <p class="eyebrow">El problema</p>
      <p class="declaracion revelar-tenue">
        El paciente hematológico recorre consultas que no se hablan entre sí, repite exámenes que ya
        se hizo, y si vive fuera de Santiago suma horas de viaje a un problema que muchas veces se
        resolvía mirando bien lo que ya tenía.
      </p>
      <div class="problema-detalle">
        <div class="revelar">
          <span class="cifra">01</span>
          <p>Cuenta su historia desde el principio en cada consulta nueva.</p>
        </div>
        <div class="revelar">
          <span class="cifra">02</span>
          <p>Repite exámenes porque el resultado quedó en otro sistema.</p>
        </div>
        <div class="revelar">
          <span class="cifra">03</span>
          <p>Viaja a Santiago porque la hematología está concentrada en pocos centros.</p>
        </div>
      </div>
    </div>
  </SeccionMedia>

  <!-- ================= CÓMO FUNCIONA · gráfico fijo ================= -->
  <section class="seccion como" id="como-funciona">
    <div class="contenedor como-rejilla">
      <div class="como-fijo">
        <p class="eyebrow">Cómo funciona la atención</p>
        <h2>Un recorrido que no se corta entre un especialista y otro</h2>
        <figure class="como-foto">
          <Picture
            src={FOTO_PRESTACION.hematologia.src}
            alt={FOTO_PRESTACION.hematologia.alt}
            widths={[500, 800]}
            sizes="(min-width: 1000px) 420px, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            loading="lazy"
          />
          <span class="como-hilo" aria-hidden="true">
            <Hilo orientacion="vertical" nodos={4} />
          </span>
        </figure>
        <div class="como-acciones"><BotonAgendar /></div>
      </div>

      <ol class="pasos">
        {
          PASOS.map((p, i) => (
            <li class="revelar">
              <span class="paso-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== LA UNIDAD ===================== -->
  <section class="seccion seccion-alt">
    <div class="contenedor">
      <p class="eyebrow">Conecta Hematología</p>
      <h2 class="titulo-seccion">
        La hematología es el eje. Lo demás entra cuando tu caso lo necesita.
      </h2>
      <p class="intro prosa">
        Gastroenterología, nutrición e imágenes no son especialidades sueltas ofrecidas en el mismo
        lugar: entran cuando el estudio hematológico las necesita, y las coordina el mismo médico
        que lleva tu caso.
      </p>

      <div class="prestaciones">
        {
          servicios.map((s) => (
            <TarjetaPrestacion
              nivel={s.data.nivel}
              titulo={s.data.nombre}
              resumen={s.data.resumen}
              href={RUTAS.prestacion(s.data.slug)}
              icono={s.data.icono}
              imagen={fotoDePrestacion(s.data.slug)?.src}
              altImagen={fotoDePrestacion(s.data.slug)?.alt}
              chips={s.data.modalidades}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== TELEMEDICINA, imagen partida ===================== -->
  <section class="partida">
    <figure class="partida-foto">
      <Picture
        src={FOTO_PAGINA.telemedicina.src}
        alt={FOTO_PAGINA.telemedicina.alt}
        widths={[600, 1000, 1400]}
        sizes="(min-width: 1000px) 50vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        loading="lazy"
      />
    </figure>
    <div class="partida-texto">
      <div class="partida-caja">
        <p class="eyebrow">Telemedicina</p>
        <h2>Qué se resuelve a distancia, y qué no</h2>
        <p class="intro">
          Decimos las dos cosas, porque una consulta a distancia que debía ser presencial no le
          sirve a nadie.
        </p>
        <ul class="lista si">
          <li>
            <Icono nombre="check" tam={18} color="var(--color-blue)" />Interpretar un hemograma o un
            perfil de hierro
          </li>
          <li>
            <Icono nombre="check" tam={18} color="var(--color-blue)" />Revisar y ajustar un
            tratamiento en curso
          </li>
          <li>
            <Icono nombre="check" tam={18} color="var(--color-blue)" />Segunda opinión sobre un
            estudio ya hecho
          </li>
          <li>
            <Icono nombre="minus" tam={18} color="var(--color-gray)" />
            <span class="tenue">Examinar un ganglio o el bazo necesita ser presencial</span>
          </li>
        </ul>
        <Boton href={RUTAS.telemedicina} variante="secondary" icono="arrow-right">
          Ver cómo funciona
        </Boton>
      </div>
    </div>
  </section>

  <!-- ===================== COMPROMISOS, en oscuro ===================== -->
  <SeccionMedia video="v-compromisos" clase="seccion seccion-oscura">
    <div class="contenedor">
      <p class="eyebrow">Nuestros compromisos</p>
      <h2 class="titulo-seccion">Cuatro cosas que puedes exigirnos</h2>
      <ul class="compromisos">
        {
          a.compromisos.map((c, i) => (
            <li class="revelar">
              <span class="compromiso-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </SeccionMedia>

  <!-- ===================== PREGUNTAS ===================== -->
  {
    faqItems.length > 0 && (
      <SeccionMedia imagen={FOTO_PAGINA.preguntas.src} velo="suave" clase="seccion">
        <div class="contenedor faq-rejilla">
          <div>
            <p class="eyebrow">Preguntas frecuentes</p>
            <h2>Lo que más nos preguntan</h2>
            <p class="intro">
              Respuestas directas, con una indicación clara de cuándo conviene consultar.
            </p>
            <Boton href={RUTAS.preguntas} variante="secondary" icono="arrow-right">
              Ver todas las preguntas
            </Boton>
          </div>
          <Acordeon items={faqItems} />
        </div>
      </SeccionMedia>
    )
  }

  <!-- ===================== UBICACIÓN Y CIERRE ===================== -->
  <SeccionMedia imagen={FOTO_PAGINA.contacto.src} velo="suave" clase="seccion">
    <div class="contenedor cierre-rejilla">
      <div>
        <p class="eyebrow">Dónde y cuándo</p>
        <h2>Ñuñoa, a pasos del Metro Plaza Egaña</h2>
        <address class="direccion">
          {cl.direccion.edificio}<br />
          {cl.direccion.calle}, {cl.direccion.oficina}<br />
          {cl.direccion.comuna}, {cl.direccion.ciudad}
        </address>
        <ul class="horarios">
          {
            cl.horarios.map((h) => (
              <li>
                <Icono nombre="clock" tam={18} color="var(--color-blue)" />
                {horarioLegible(h)}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="cta-final">
        <h2>¿Necesitas una hora?</h2>
        <p>Puedes pedirla sin derivación previa. Te confirmamos dentro del próximo día hábil.</p>
        <div class="cta-acciones">
          <BotonAgendar tam="lg" />
          <Boton href={RUTAS.contacto} variante="secondary" tam="lg">Formas de contacto</Boton>
        </div>
      </div>
    </div>
  </SeccionMedia>
</Base>

<style>
  /* ---------- barra de datos ---------- */
  .datos {
    background: var(--color-blue-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .datos-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
  }
  .sin-derivacion {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a9c4e8;
  }
  /* Los chips sobre azul profundo: borde claro en vez de fondo azul nube. */
  .datos :global(.chip) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .datos :global(.chip .icono) {
    background: #a9c4e8 !important;
  }

  /* ---------- el problema ---------- */
  .declaracion {
    margin-top: var(--space-6);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.6rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    max-width: 24ch;
  }
  @media (min-width: 900px) {
    .declaracion {
      max-width: 30ch;
    }
  }
  .problema-detalle {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-16);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: var(--space-8);
  }
  @media (min-width: 800px) {
    .problema-detalle {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-10);
    }
  }
  .problema-detalle p {
    margin-top: var(--space-3);
    font-size: var(--text-body);
    line-height: 1.6;
    color: #c9d9f0;
    max-width: 32ch;
  }
  .cifra {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: #7fa5d8;
  }

  /* ---------- cómo funciona ---------- */
  .como-rejilla {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 1000px) {
    .como-rejilla {
      grid-template-columns: 0.85fr 1fr;
      gap: var(--space-20);
      align-items: start;
    }
    /* El bloque de la izquierda se queda fijo mientras la lista scrollea.
       Es el recurso de la referencia, y acá cuesta cero JavaScript. */
    .como-fijo {
      position: sticky;
      top: 120px;
    }
  }
  .como-fijo h2 {
    margin-top: var(--space-3);
    max-width: 18ch;
  }
  /* La columna fija deja de ser solo tipografía: lleva la fotografía del
     hemograma, con el hilo Conecta montado en el borde. */
  .como-foto {
    position: relative;
    margin: var(--space-8) 0 0;
  }
  .como-foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  .como-hilo {
    display: none;
  }
  @media (min-width: 1000px) {
    .como-hilo {
      display: block;
      position: absolute;
      left: calc(var(--space-6) * -1);
      top: var(--space-6);
      bottom: var(--space-6);
      width: 14px;
    }
  }
  .como-acciones {
    margin-top: var(--space-8);
  }

  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .pasos li {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-8);
    border-bottom: var(--border-width) solid var(--color-line);
  }
  .pasos li:first-child {
    padding-top: 0;
  }
  .pasos li:last-child {
    border-bottom: 0;
  }
  .paso-num {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-blue);
    padding-top: 6px;
    flex-shrink: 0;
  }
  .pasos h3 {
    font-size: var(--text-h3);
  }
  .pasos p {
    margin-top: var(--space-3);
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-gray);
    max-width: 46ch;
  }

  /* ---------- prestaciones ---------- */
  .titulo-seccion {
    margin-top: var(--space-3);
    max-width: 26ch;
  }
  .intro {
    margin-top: var(--space-5);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .prestaciones {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-12);
  }
  @media (min-width: 700px) {
    .prestaciones {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .prestaciones {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
    .prestaciones > :first-child {
      grid-row: span 2;
    }
  }

  /* ---------- sección partida ---------- */
  .partida {
    display: grid;
    background: var(--color-white);
  }
  @media (min-width: 1000px) {
    .partida {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }
  .partida-foto {
    margin: 0;
  }
  .partida-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 1000px) {
    .partida-foto :global(img) {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }
  .partida-texto {
    display: flex;
    align-items: center;
    padding-block: var(--section-y);
  }
  .partida-caja {
    padding-inline: var(--margin-x);
    max-width: 620px;
  }
  @media (min-width: 1000px) {
    .partida-caja {
      padding-inline: var(--space-16) var(--space-10);
    }
  }
  .lista {
    list-style: none;
    margin: var(--space-8) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .lista li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .tenue {
    color: var(--color-gray);
  }

  /* ---------- compromisos ---------- */
  .compromisos {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 700px) {
    .compromisos {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-10) var(--space-12);
    }
  }
  .compromisos li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    line-height: 1.35;
    color: #fff;
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .compromiso-num {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: #7fa5d8;
    flex-shrink: 0;
  }

  /* ---------- faq y cierre ---------- */
  .faq-rejilla,
  .cierre-rejilla {
    display: grid;
    gap: var(--space-10);
  }
  @media (min-width: 1000px) {
    .faq-rejilla {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-16);
      align-items: start;
    }
    .cierre-rejilla {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
  .faq-rejilla .intro {
    margin-bottom: var(--space-6);
  }
  .direccion {
    font-style: normal;
    margin-top: var(--space-5);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  .horarios {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
  }
  .horarios li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .cta-final {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-1);
    align-self: start;
  }
  .cta-final p {
    margin-top: var(--space-4);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-gray);
  }
  .cta-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
