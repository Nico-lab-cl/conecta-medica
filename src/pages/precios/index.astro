---
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import NotaInfo from '../../components/notices/NotaInfo.astro';
import Icono from '../../components/core/Icono.astro';
import BotonAgendar from '../../components/actions/BotonAgendar.astro';
import BotonWhatsApp from '../../components/actions/BotonWhatsApp.astro';
import { RUTAS, migas } from '../../lib/rutas';
import { leerPagina, propsCabecera } from '../../lib/paginas';
import { ajustes, pais } from '../../lib/contenido';

const a = await ajustes();
const cl = (await pais('cl')).data;
const ruta = migas({ label: 'Pago y reembolso' });

const P = await leerPagina('paginaPago', 'pago');
const cab = await propsCabecera(P, { foto: FOTO_PAGINA.precios, og: '/og/precios.jpg' });
---

<Pagina
  {...cab}
  ruta={RUTAS.precios}
  actual={RUTAS.precios}
  migas={ruta}
>

  <section class="seccion">
    <div class="contenedor">
      <p class="nota-prevision">{a.precioNota}</p>

      <div class="dos">
        <div>
          <h2>{P.incluye.titulo}</h2>
          <ul class="lista">
            {
              P.incluye.items.map((i) => (
                <li>
                  <Icono nombre="check" tam={18} color="var(--color-blue)" />
                  {i}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>{P.aparte.titulo}</h2>
          <ul class="lista tenue">
            {
              P.aparte.items.map((i) => (
                <li>
                  <Icono nombre="minus" tam={18} color="var(--color-gray)" />
                  {i}
                </li>
              ))
            }
          </ul>
          <p class="nota">{P.aparte.nota}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor prosa">
      <h2>{P.particular.titulo}</h2>
      {P.particular.parrafos.map((t) => <p class="parrafo">{t}</p>)}

      {
        cl.medioPago.length > 0 ? (
          <>
            <h3 class="sub">Medios de pago</h3>
            <ul class="lista">
              {cl.medioPago.map((m) => (
                <li>
                  <Icono nombre="check" tam={18} color="var(--color-blue)" />
                  {m}
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="pendiente">
            <NotaInfo titulo={P.notaMediosPago.titulo}>{P.notaMediosPago.texto}</NotaInfo>
          </div>
        )
      }
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor cierre">
      <h2>{P.cierre.titulo}</h2>
      <p>{P.cierre.texto}</p>
      <div class="acciones">
        <BotonAgendar tam="lg" />
        <BotonWhatsApp origen="precios" />
      </div>
    </div>
  </section>
</Pagina>

<style>
  .nota-prevision {
    max-width: 60ch;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }
  .dos {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-12);
  }
  @media (min-width: 900px) {
    .dos {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
  .lista {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .lista li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .lista.tenue li {
    color: var(--color-gray);
  }
  .nota {
    margin-top: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--color-gray);
  }
  .parrafo {
    margin-top: var(--space-5);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  .sub {
    margin-top: var(--space-10);
  }
  .pendiente {
    margin-top: var(--space-10);
  }
  .cierre p {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-gray);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
