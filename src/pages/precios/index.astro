---
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import NotaInfo from '../../components/notices/NotaInfo.astro';
import Icono from '../../components/core/Icono.astro';
import BotonAgendar from '../../components/actions/BotonAgendar.astro';
import BotonWhatsApp from '../../components/actions/BotonWhatsApp.astro';
import { RUTAS, migas } from '../../lib/rutas';
import { ajustes, pais } from '../../lib/contenido';

const a = await ajustes();
const cl = (await pais('cl')).data;
const ruta = migas({ label: 'Pago y reembolso' });

const incluye = [
  'El tiempo de la consulta con el médico',
  'La revisión de los exámenes que traigas, incluidos los antiguos',
  'La explicación del diagnóstico y del plan',
  'La boleta correspondiente',
];
const noIncluye = [
  'Exámenes de laboratorio',
  'Imágenes (ecografías, tomografías)',
  'Procedimientos',
];
---

<Pagina
  titulo="Pago, boleta y reembolso"
  descripcion="Qué incluye la consulta, cómo funciona la boleta para pedir reembolso y por qué la atención es particular. El valor de cada prestación lo ves al agendar."
  ruta={RUTAS.precios}
  actual={RUTAS.precios}
  eyebrow="Pago y reembolso"
  h1="Cómo funciona el pago de tu atención"
  bajada="El valor depende de la prestación que necesites, y lo ves al elegir tu hora, antes de confirmarla."
  migas={ruta}
  foto={FOTO_PAGINA.precios}
  imagenOg="/og/precios.jpg"
>

  <section class="seccion">
    <div class="contenedor">
      <p class="nota-prevision">{a.precioNota}</p>

      <div class="dos">
        <div>
          <h2>Qué incluye</h2>
          <ul class="lista">
            {
              incluye.map((i) => (
                <li>
                  <Icono nombre="check" tam={18} color="var(--color-blue)" />
                  {i}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Qué se cotiza aparte</h2>
          <ul class="lista tenue">
            {
              noIncluye.map((i) => (
                <li>
                  <Icono nombre="minus" tam={18} color="var(--color-gray)" />
                  {i}
                </li>
              ))
            }
          </ul>
          <p class="nota">
            Si tu caso necesita alguno, se te dice el costo antes de que decidas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor prosa">
      <h2>Atención particular, sin convenios</h2>
      <p class="parrafo">
        No trabajamos con Fonasa ni con isapres en convenio. Lo decimos así de directo porque
        preferimos que lo sepas antes de agendar y no cuando llegues al mostrador.
      </p>
      <p class="parrafo">
        Si tienes un seguro complementario de salud, la boleta te sirve para pedir reembolso.
        Cuánto te devuelvan depende de tu plan y de tu asegurador, y eso no es algo que nosotros
        podamos comprometer.
      </p>

      {
        cl.medioPago.length > 0 ? (
          <>
            <h3 class="sub">Medios de pago</h3>
            <ul class="lista">
              {cl.medioPago.map((m) => (
                <li>
                  <Icono nombre="check" tam={18} color="var(--color-blue)" />
                  {m}
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="pendiente">
            <NotaInfo titulo="Medios de pago y política de anulación">
              Estamos terminando de definir los medios de pago aceptados y la política de anulación.
              Preferimos no publicarlos hasta tenerlos confirmados: si tienes dudas antes de
              agendar, escríbenos y te respondemos.
            </NotaInfo>
          </div>
        )
      }
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor cierre">
      <h2>El valor lo ves al agendar</h2>
      <p>Al elegir tu hora ves el valor de la prestación. No necesitas derivación previa.</p>
      <div class="acciones">
        <BotonAgendar tam="lg" />
        <BotonWhatsApp origen="precios" />
      </div>
    </div>
  </section>
</Pagina>

<style>
  .nota-prevision {
    max-width: 60ch;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }
  .dos {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-12);
  }
  @media (min-width: 900px) {
    .dos {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
  .lista {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .lista li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .lista.tenue li {
    color: var(--color-gray);
  }
  .nota {
    margin-top: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--color-gray);
  }
  .parrafo {
    margin-top: var(--space-5);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  .sub {
    margin-top: var(--space-10);
  }
  .pendiente {
    margin-top: var(--space-10);
  }
  .cierre p {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-gray);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
