---
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import Icono from '../../components/core/Icono.astro';
import DescargoClinico from '../../components/notices/DescargoClinico.astro';
import BotonAgendar from '../../components/actions/BotonAgendar.astro';
import BotonWhatsApp from '../../components/actions/BotonWhatsApp.astro';
import AvisoUrgencias from '../../components/notices/AvisoUrgencias.astro';
import { RUTAS, migas } from '../../lib/rutas';
import { faqsPublicables } from '../../lib/contenido';
import { faqJsonLd } from '../../lib/schema';
import { render } from 'astro:content';

/* Hub de preguntas.

   Estructura fija de cada respuesta: pregunta → respuesta corta → detalle →
   cuándo consultar. No es preferencia editorial: en los SERP de Chile para estas
   consultas, AI Overview y People Also Ask ocupan las posiciones 1 y 2, y el
   primer clic orgánico está en la 3. La respuesta directa arriba es lo que
   permite ser la fuente de ese resumen. Ver docs/seo-keywords.md §3.

   ACORDEÓN (2026-09-08). Antes las dieciséis respuestas iban desplegadas una
   tras otra: la página medía varias pantallas y encontrar una pregunta concreta
   era imposible. Ahora cada una es un <details> cerrado, como en la portada v3,
   así que la página abre siendo la lista de preguntas y el visitante despliega
   la suya.

   Tres cosas que esto NO cambia:

   · El SEO. <details> guarda el texto en el DOM, no lo carga después: Google lo
     indexa igual, Ctrl+F lo encuentra dentro de un acordeón cerrado, y el
     FAQPage de datos estructurados sigue llevando las respuestas completas.
   · La accesibilidad. Es el elemento nativo, con su semántica de siempre y sin
     una línea de JavaScript para abrir y cerrar.
   · El encabezado de cada pregunta, que sigue siendo un <h3> real.

   El índice "En esta página" se fue con el cambio: el acordeón cerrado ya es
   ese índice, y tenerlo dos veces era repetir la misma lista. */

const todas = await faqsPublicables();
const clinicas = todas.filter((f) => f.data.categoria === 'clinica');
const operativas = todas.filter((f) => f.data.categoria === 'operativa');

const renderizadas = await Promise.all(
  todas.map(async (f) => ({ entrada: f, Content: (await render(f)).Content })),
);
const porId = new Map(renderizadas.map((r) => [r.entrada.id, r.Content]));

const ruta = migas({ label: 'Preguntas frecuentes' });
const fmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Pagina
  titulo="Preguntas frecuentes de hematología — Clínica Conecta"
  descripcion="Anemia por falta de hierro, ferritina baja, plaquetas y leucocitos bajos, ganglios aumentados y anticoagulantes, respondidas por un hematólogo en Chile."
  ruta={RUTAS.preguntas}
  actual={RUTAS.preguntas}
  eyebrow="Preguntas frecuentes"
  h1="Lo que más nos preguntan"
  bajada="Respuestas directas, en lenguaje simple, con una indicación clara de cuándo conviene consultar. Son información general y no reemplazan una evaluación médica."
  migas={ruta}
  foto={FOTO_PAGINA.preguntas}
  imagenOg="/og/preguntas.jpg"
  jsonLd={[faqJsonLd(todas.map((f) => f.data))]}
>

  {
    clinicas.length > 0 && (
      <section class="seccion">
        <div class="contenedor">
          <h2 class="grupo">Sobre tus exámenes y tu tratamiento</h2>
          <div class="lista-faq">
            {clinicas.map((f, i) => {
              const Cuerpo = porId.get(f.id);
              return (
                <details class="faq" id={f.data.slug} open={i === 0}>
                  <summary>
                    <h3>
                      <span>{f.data.pregunta}</span>
                      <Icono nombre="plus" tam={22} color="var(--color-blue)" clase="mas" />
                      <Icono nombre="minus" tam={22} color="var(--color-blue)" clase="menos" />
                    </h3>
                  </summary>
                  <div class="respuesta">
                    <p class="corta">{f.data.respuestaCorta.trim()}</p>
                    <div class="detalle contenido-mdx">{Cuerpo && <Cuerpo />}</div>
                    {f.data.cuandoConsultar && (
                      <div class="consultar">
                        <Icono nombre="triangle-alert" tam={20} color="var(--color-blue)" />
                        <div>
                          <p class="consultar-titulo">Cuándo consultar</p>
                          <p>{f.data.cuandoConsultar}</p>
                        </div>
                      </div>
                    )}
                    <p class="firma">
                      {f.data.revisado && f.data.fechaRevision ? (
                        <>
                          <Icono nombre="check" tam={16} color="var(--color-blue)" />
                          Revisado por Dr. Carlos Flores Angulo · {fmt.format(f.data.fechaRevision)}
                        </>
                      ) : (
                        <span class="borrador">
                          Borrador. Pendiente de revisión del médico. No visible en producción.
                        </span>
                      )}
                    </p>
                  </div>
                </details>
              );
            })}
          </div>
          <DescargoClinico />
        </div>
      </section>
    )
  }

  <section class="seccion seccion-alt">
    <div class="contenedor">
      <h2 class="grupo">Cómo funciona la atención</h2>
      <div class="lista-faq">
        {
          operativas.map((f, i) => {
            const Cuerpo = porId.get(f.id);
            return (
              <details class="faq" id={f.data.slug} open={clinicas.length === 0 && i === 0}>
                <summary>
                  <h3>
                    <span>{f.data.pregunta}</span>
                    <Icono nombre="plus" tam={22} color="var(--color-blue)" clase="mas" />
                    <Icono nombre="minus" tam={22} color="var(--color-blue)" clase="menos" />
                  </h3>
                </summary>
                <div class="respuesta">
                  <p class="corta">{f.data.respuestaCorta.trim()}</p>
                  <div class="detalle contenido-mdx">{Cuerpo && <Cuerpo />}</div>
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </section>

  <script>
    /* Los enlaces con ancla —desde la portada, desde el buscador o compartidos—
       apuntan a una pregunta concreta. Si esa pregunta está plegada, el
       navegador no siempre la abre: acá se abre y se lleva a la vista. */
    const abrirDelAncla = (desplazar: boolean) => {
      if (!location.hash) return;
      const destino = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (!(destino instanceof HTMLDetailsElement)) return;
      destino.open = true;
      if (desplazar) destino.scrollIntoView();
    };
    abrirDelAncla(true);
    addEventListener('hashchange', () => abrirDelAncla(false));
  </script>

  <section class="seccion">
    <div class="contenedor cierre">
      <AvisoUrgencias />
      <div class="acciones">
        <BotonAgendar tam="lg" />
        <BotonWhatsApp origen="preguntas" />
      </div>
    </div>
  </section>
</Pagina>

<style>
  .grupo {
    max-width: 24ch;
  }

  /* Mismo acordeón que usa Acordeon.astro en el resto del sitio: <details>
     nativo, el signo cambia de más a menos, y la línea divisoria es lo único
     que separa una pregunta de la siguiente. */
  .lista-faq {
    margin-top: var(--space-8);
    max-width: var(--measure-prose);
    border-top: var(--border-width) solid var(--color-line);
  }
  .faq {
    border-bottom: var(--border-width) solid var(--color-line);
    scroll-margin-top: 120px;
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-sm);
  }
  .faq h3 {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    justify-content: space-between;
    min-height: var(--touch-min);
    padding-block: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: 1.4;
    color: var(--color-ink);
    text-wrap: pretty;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .faq summary:hover h3 {
    color: var(--color-blue);
  }
  .faq h3 :global(.mas),
  .faq h3 :global(.menos) {
    margin-top: 2px;
  }
  .faq h3 :global(.menos) {
    display: none;
  }
  .faq[open] h3 :global(.mas) {
    display: none;
  }
  .faq[open] h3 :global(.menos) {
    display: inline-block;
  }

  .respuesta {
    padding-bottom: var(--space-8);
  }
  /* La respuesta corta va primero y destacada: es la que se extrae. */
  .corta {
    font-family: var(--font-serif);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-blue-deep);
    border-left: var(--border-width-emph) solid var(--color-blue);
    padding-left: var(--space-5);
  }
  .detalle {
    margin-top: var(--space-6);
  }
  .consultar {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding: var(--space-5);
    background: var(--surface-alt);
    border-radius: var(--radius-md);
  }
  .consultar-titulo {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }
  .consultar p {
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }
  .firma {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-caption);
    color: var(--color-gray);
  }
  .borrador {
    color: var(--color-alert);
    font-family: var(--font-mono);
  }
  .cierre {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
