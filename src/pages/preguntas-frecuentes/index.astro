---
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import Icono from '../../components/core/Icono.astro';
import DescargoClinico from '../../components/notices/DescargoClinico.astro';
import BotonAgendar from '../../components/actions/BotonAgendar.astro';
import BotonWhatsApp from '../../components/actions/BotonWhatsApp.astro';
import AvisoUrgencias from '../../components/notices/AvisoUrgencias.astro';
import { RUTAS, migas } from '../../lib/rutas';
import { faqsPublicables } from '../../lib/contenido';
import { faqJsonLd } from '../../lib/schema';
import { render } from 'astro:content';

/* Hub de preguntas.

   Estructura fija de cada respuesta: pregunta → respuesta corta → detalle →
   cuándo consultar. No es preferencia editorial: en los SERP de Chile para estas
   consultas, AI Overview y People Also Ask ocupan las posiciones 1 y 2, y el
   primer clic orgánico está en la 3. La respuesta directa arriba es lo que
   permite ser la fuente de ese resumen. Ver docs/seo-keywords.md §3. */

const todas = await faqsPublicables();
const clinicas = todas.filter((f) => f.data.categoria === 'clinica');
const operativas = todas.filter((f) => f.data.categoria === 'operativa');

const renderizadas = await Promise.all(
  todas.map(async (f) => ({ entrada: f, Content: (await render(f)).Content })),
);
const porId = new Map(renderizadas.map((r) => [r.entrada.id, r.Content]));

const ruta = migas({ label: 'Preguntas frecuentes' });
const fmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Pagina
  titulo="Preguntas frecuentes de hematología — Clínica Conecta"
  descripcion="Anemia por falta de hierro, ferritina baja, plaquetas y leucocitos bajos, ganglios aumentados y anticoagulantes, respondidas por un hematólogo en Chile."
  ruta={RUTAS.preguntas}
  actual={RUTAS.preguntas}
  eyebrow="Preguntas frecuentes"
  h1="Lo que más nos preguntan"
  bajada="Respuestas directas, en lenguaje simple, con una indicación clara de cuándo conviene consultar. Son información general y no reemplazan una evaluación médica."
  migas={ruta}
  foto={FOTO_PAGINA.preguntas}
  imagenOg="/og/preguntas.jpg"
  jsonLd={[faqJsonLd(todas.map((f) => f.data))]}
>

  <div class="contenedor indice">
    <nav aria-labelledby="indice-titulo">
      <p class="eyebrow" id="indice-titulo">En esta página</p>
      <ol>
        {todas.map((f) => <li><a href={`#${f.data.slug}`}>{f.data.pregunta}</a></li>)}
      </ol>
    </nav>
  </div>

  {
    clinicas.length > 0 && (
      <section class="seccion">
        <div class="contenedor">
          <h2 class="grupo">Sobre tus exámenes y tu tratamiento</h2>
          <div class="lista-faq">
            {clinicas.map((f) => {
              const Cuerpo = porId.get(f.id);
              return (
                <article class="faq" id={f.data.slug}>
                  <h3>{f.data.pregunta}</h3>
                  <p class="corta">{f.data.respuestaCorta.trim()}</p>
                  <div class="detalle contenido-mdx">{Cuerpo && <Cuerpo />}</div>
                  {f.data.cuandoConsultar && (
                    <div class="consultar">
                      <Icono nombre="triangle-alert" tam={20} color="var(--color-blue)" />
                      <div>
                        <p class="consultar-titulo">Cuándo consultar</p>
                        <p>{f.data.cuandoConsultar}</p>
                      </div>
                    </div>
                  )}
                  <p class="firma">
                    {f.data.revisado && f.data.fechaRevision ? (
                      <>
                        <Icono nombre="check" tam={16} color="var(--color-blue)" />
                        Revisado por Dr. Carlos Flores Angulo · {fmt.format(f.data.fechaRevision)}
                      </>
                    ) : (
                      <span class="borrador">
                        Borrador. Pendiente de revisión del médico. No visible en producción.
                      </span>
                    )}
                  </p>
                </article>
              );
            })}
          </div>
          <DescargoClinico />
        </div>
      </section>
    )
  }

  <section class="seccion seccion-alt">
    <div class="contenedor">
      <h2 class="grupo">Cómo funciona la atención</h2>
      <div class="lista-faq">
        {
          operativas.map((f) => {
            const Cuerpo = porId.get(f.id);
            return (
              <article class="faq" id={f.data.slug}>
                <h3>{f.data.pregunta}</h3>
                <p class="corta">{f.data.respuestaCorta.trim()}</p>
                <div class="detalle contenido-mdx">{Cuerpo && <Cuerpo />}</div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor cierre">
      <AvisoUrgencias />
      <div class="acciones">
        <BotonAgendar tam="lg" />
        <BotonWhatsApp origen="preguntas" />
      </div>
    </div>
  </section>
</Pagina>

<style>
  .indice {
    margin-top: var(--space-8);
  }
  .indice nav {
    background: var(--surface-alt);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    max-width: 860px;
  }
  .indice ol {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
  }
  .indice a {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .grupo {
    max-width: 24ch;
  }
  .lista-faq {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin-top: var(--space-10);
  }
  .faq {
    max-width: var(--measure-prose);
    scroll-margin-top: 100px;
  }
  .faq h3 {
    font-size: var(--text-h2);
    line-height: var(--text-h2-lh);
    letter-spacing: var(--text-h2-ls);
  }
  /* La respuesta corta va primero y destacada: es la que se extrae. */
  .corta {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-blue-deep);
    border-left: var(--border-width-emph) solid var(--color-blue);
    padding-left: var(--space-5);
  }
  .detalle {
    margin-top: var(--space-8);
  }
  .consultar {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding: var(--space-5);
    background: var(--surface-alt);
    border-radius: var(--radius-md);
  }
  .consultar-titulo {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }
  .consultar p {
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }
  .firma {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-caption);
    color: var(--color-gray);
  }
  .borrador {
    color: var(--color-alert);
    font-family: var(--font-mono);
  }
  .cierre {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
