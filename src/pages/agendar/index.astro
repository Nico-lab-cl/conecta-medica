---
/* Página de agenda.

   Existe desde el día uno y NO cambia cuando llegue Medinet: lo único que cambia
   es `agendamiento.modo` en el CMS. En "formulario" muestra el formulario
   propio; en "iframe" monta la agenda del proveedor. El resto del sitio —los
   trece CTA que apuntan acá— no se toca.

   El diseño está pensado para funcionar con un bloque opaco al medio: cabecera
   propia con instrucciones, la agenda, y debajo el WhatsApp como salida para
   quien se atasque. El flujo de RUT deja gente en el camino, sobre todo adultos
   mayores y pacientes extranjeros. */
import { FOTO_PAGINA } from '../../lib/imagenes';
import Pagina from '../../layouts/Pagina.astro';
import FormularioHora from '../../components/forms/FormularioHora.astro';
import EmbedAgenda from '../../components/agenda/EmbedAgenda.astro';
import BotonWhatsApp from '../../components/actions/BotonWhatsApp.astro';
import EnlaceTexto from '../../components/actions/EnlaceTexto.astro';
import Icono from '../../components/core/Icono.astro';
import AvisoUrgencias from '../../components/notices/AvisoUrgencias.astro';
import '../../styles/formulario.css';
import { RUTAS, migas } from '../../lib/rutas';
import { leerPagina, propsCabecera } from '../../lib/paginas';
import { ajustes, pais, horarioLegible } from '../../lib/contenido';

const a = await ajustes();
const cl = (await pais('cl')).data;
const ruta = migas({ label: 'Agendar hora' });
const claveTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const conIframe = a.agendamiento.modo === 'iframe' && Boolean(a.agendamiento.src);
const P = await leerPagina('paginaAgendar', 'agendar');
const cab = await propsCabecera(P, { foto: FOTO_PAGINA.agendar, og: '/og/agendar.jpg' });

/* Modo "enlace": la agenda vive entera en el proveedor y esta página sólo
   reenvía. Es estática, así que el reenvío va por meta refresh y por script, y
   queda un enlace visible por si el navegador no sigue ninguno de los dos.
   Va con noindex: lo que se indexa es la agenda, no un paso intermedio. */
const destinoDirecto = a.agendamiento.modo === 'enlace' ? a.agendamiento.src : null;
---

{destinoDirecto ? (
  <html lang="es-CL">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex" />
      <meta http-equiv="refresh" content={`0;url=${destinoDirecto}`} />
      <title>Agendar hora — Clínica Conecta</title>
      <script is:inline define:vars={{ destinoDirecto }}>location.replace(destinoDirecto);</script>
    </head>
    <body style="font-family:system-ui,sans-serif;padding:2rem;text-align:center">
      <p>Te estamos llevando a la agenda…</p>
      <p><a href={destinoDirecto}>Si no avanza, entra acá</a></p>
    </body>
  </html>
) : (
<Pagina
  {...cab}
  bajada={conIframe ? P.cabecera.bajadaConAgenda : P.cabecera.bajada}
  ruta={RUTAS.agendar}
  actual={RUTAS.agendar}
  migas={ruta}
>

  <section class="seccion">
    <div class="contenedor columnas">
      <div class="principal">
        {
          conIframe ? (
            <EmbedAgenda
              src={a.agendamiento.src!}
              altura={a.agendamiento.altura}
              proveedor={a.agendamiento.proveedor}
              politicaProveedor={a.agendamiento.politicaPrivacidadProveedor}
            />
          ) : (
            <>
              <FormularioHora claveTurnstile={claveTurnstile} retorno="/agendar/" />
            </>
          )
        }

        {/* Salida siempre visible para quien se atasque. */}
        <div class="salida">
          <h2>{P.salida.titulo}</h2>
          <p>{P.salida.texto}</p>
          <div class="salida-acciones">
            <BotonWhatsApp origen="agendar" />
            <EnlaceTexto href={`mailto:${a.correoAgenda}`}>{a.correoAgenda}</EnlaceTexto>
          </div>
        </div>
      </div>

      <aside class="lateral">
        <div class="bloque">
          <h2>{P.saber.titulo}</h2>
          <ul class="datos">
            {P.saber.items.map((x) => (
              <li>
                <Icono nombre={x.icono} tam={20} color="var(--color-blue)" />
                <span>{x.texto}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bloque">
          <h2>Horarios</h2>
          <ul class="horarios">
            {
              cl.horarios.map((h) => (
                <li>
                  <Icono nombre="clock" tam={18} color="var(--color-blue)" />
                  {horarioLegible(h)}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor"><AvisoUrgencias /></div>
  </section>
</Pagina>
)}

<style>
  .columnas {
    display: grid;
    gap: var(--space-12);
  }
  @media (min-width: 1000px) {
    .columnas {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-16);
    }
  }
  .principal {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .salida {
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-lg);
    max-width: 620px;
  }
  .salida h2 {
    font-size: var(--text-h3);
  }
  .salida p {
    margin-top: var(--space-3);
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--color-gray);
  }
  .salida-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .lateral {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .bloque {
    padding: var(--space-6);
    background: var(--surface-alt);
    border-radius: var(--radius-lg);
  }
  .bloque h2 {
    font-size: var(--text-h3);
  }
  .datos {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }
  .datos li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .horarios {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
  }
  .horarios li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
</style>
