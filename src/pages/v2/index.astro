---
/* Portada, versión comercial.

   Convive con `/` para poder compararlas. Esta sigue el formato de las clínicas
   privadas chilenas que se estudiaron en `docs/competencia.md` y
   `docs/clinicas-diseno.md`, con Clínica Alemana como referencia principal —el
   mejor sitio de salud del país— pero sobre fondo blanco y con los azules
   Conecta en vez de la pizarra oscura de Alemana.

   Qué se copió, y por qué:

   1. HERO COMPACTO CON RESERVA ENCIMA. Alemana no gasta la primera pantalla en
      una imagen: la gasta en dejar la reserva al alcance. Acá el hero mide poco
      más de media pantalla y el bloque de solicitar hora va integrado, no
      superpuesto encima como en los otros doce.
   2. "¿QUÉ NECESITAS HACER?" Es el patrón que mejor funciona de Alemana: una
      grilla de tareas, no de servicios. La gente entra a hacer algo.
   3. FRANJA DE CONFIANZA bajo el pliegue con los hechos verificables.

   Qué NO se copió, deliberadamente:

   - El carrusel promocional. Lo tienen 11 de los 13 sitios revisados, y nadie
     ve el segundo slide.
   - La barra de utilidad con accesos a intranet, webmail y portal de
     prestadores: Conecta no tiene ninguno de esos sistemas, y ponerlos sería
     inventar.
   - Las tres o cinco tipografías. Acá siguen siendo dos, las del design system.
   - Los cuatro o seis colores saturados. Acá manda un azul.

   Y dos cosas que no hace ninguno de los trece: el precio va sobre el pliegue,
   y hay contenido que responde preguntas en la portada misma. */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Boton from '../../components/actions/Boton.astro';
import Icono from '../../components/core/Icono.astro';
import TarjetaPrestacion from '../../components/content/TarjetaPrestacion.astro';
import Acordeon from '../../components/content/Acordeon.astro';
import { RUTAS } from '../../lib/rutas';
import {
  ajustes,
  pais,
  serviciosActivos,
  faqsDestacadas,
  horarioLegible,
  precioCLP,
} from '../../lib/contenido';
import { faqJsonLd } from '../../lib/schema';
import { fotoDePrestacion, FOTO_PAGINA } from '../../lib/imagenes';

const a = await ajustes();
const cl = (await pais('cl')).data;
const servicios = await serviciosActivos();
const destacadas = await faqsDestacadas(4);

/* La misma lista cerrada del formulario. Si acá hubiera un motivo que el
   formulario no acepta, el paciente elegiría algo que después no puede enviar. */
const MOTIVOS = [
  'Hemograma alterado',
  'Anemia',
  'Plaquetas bajas o altas',
  'Control de tratamiento hematológico',
  'Interpretación de imágenes',
  'Otra derivación de mi médico',
];

/* Tareas, no servicios. Es lo que Alemana pone primero y lo que la gente viene
   a hacer. Cada una lleva a una página que ya existe. */
const TAREAS = [
  {
    icono: 'calendar',
    titulo: 'Solicitar una hora',
    texto: 'Presencial en Ñuñoa o por telemedicina.',
    href: RUTAS.agendar,
  },
  {
    icono: 'file-text',
    titulo: 'Ver cuánto cuesta',
    texto: `Consulta ${precioCLP(a.precioConsulta)}, publicado.`,
    href: RUTAS.precios,
  },
  {
    icono: 'video',
    titulo: 'Atenderme en línea',
    texto: 'Desde cualquier región de Chile.',
    href: RUTAS.telemedicina,
  },
  {
    icono: 'activity',
    titulo: 'Entender mi examen',
    texto: 'Qué significa lo que te salió alterado.',
    href: RUTAS.preguntas,
  },
];

/* Cada razón lleva a la página que la prueba. Es el punto entero de la
   sección: dejan de ser eslóganes y pasan a ser afirmaciones que el paciente
   puede ir a comprobar. Ninguna de las trece clínicas revisadas lo hace.

   El sábado se toma del horario real cargado en el CMS, no de una frase
   escrita a mano: si Carlos cambia el horario, la ficha cambia con él. */
const sabado = cl.horarios.find((h) => h.dia === 'Sábado');

const RAZONES = [
  {
    cifra: precioCLP(a.precioConsulta),
    titulo: 'El valor, publicado',
    texto: 'Atención particular, sin Fonasa ni isapres.',
    href: RUTAS.precios,
  },
  {
    cifra: 'Todo Chile',
    titulo: 'Telemedicina',
    texto: 'Sin viajar a Santiago.',
    href: RUTAS.telemedicina,
  },
  {
    cifra: sabado ? `Sábado ${sabado.desde}` : 'Sábado',
    titulo: 'También fin de semana',
    texto: 'Y sin derivación de otro médico.',
    href: RUTAS.contacto,
  },
  {
    cifra: 'A la hora',
    titulo: 'Puntualidad',
    texto: 'La hora que te damos se respeta.',
    href: RUTAS.conocenos,
  },
];

const foto = FOTO_PAGINA['inicio'];
---

<Base
  titulo="Hematólogo en Ñuñoa y telemedicina — Clínica Conecta"
  descripcion={`Atención hematológica en Ñuñoa y por telemedicina en todo Chile. Consulta particular ${precioCLP(a.precioConsulta)}. Sin derivación previa.`}
  ruta="/v2/"
  actual="inicio"
  noindex={true}
  jsonLd={destacadas.length ? [faqJsonLd(destacadas.map((f) => f.data))] : []}
  heroSuelto={true}
>
  <!-- ==================== HERO COMPACTO + RESERVA ==================== -->
  <section class="hero">
    <div class="hero-fondo">
      {
        foto && (
          <Picture
            src={foto.src}
            alt={foto.alt}
            widths={[800, 1280, 1920]}
            sizes="100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      <span class="hero-velo" aria-hidden="true"></span>
    </div>

    <div class="contenedor hero-rejilla">
      <div class="hero-texto">
        <p class="hero-eyebrow entra" style="--retraso:0ms">
          Ñuñoa · Santiago · y telemedicina en todo Chile
        </p>
        <h1 class="entra" style="--retraso:70ms">Atención hematológica coordinada</h1>
        <p class="hero-bajada entra" style="--retraso:140ms">{a.tagline}.</p>
      </div>

      <!-- El bloque de reserva va DENTRO del hero, no encima. Es la diferencia
           entre Alemana y los otros doce, y es lo que hace que se vea comercial
           sin verse recargado. -->
      <form class="reserva entra" style="--retraso:210ms" method="get" action={RUTAS.agendar}>
        <p class="reserva-titulo">Solicitar una hora</p>

        <label class="campo">
          <span>Motivo de consulta</span>
          <select name="motivo">
            <option value="">Selecciona un motivo</option>
            {MOTIVOS.map((m) => <option value={m}>{m}</option>)}
          </select>
        </label>

        <label class="campo">
          <span>Modalidad</span>
          <select name="modalidad">
            <option value="presencial">Presencial en Ñuñoa</option>
            <option value="telemedicina">Telemedicina</option>
          </select>
        </label>

        <Boton type="submit" variante="primary" tam="lg" anchoCompleto icono="arrow-right" posicionIcono="right">
          Continuar
        </Boton>

        <p class="reserva-nota">
          Sin derivación previa. Te confirmamos por correo o WhatsApp.
        </p>
      </form>
    </div>
  </section>

  <!-- ==================== POR QUÉ CONECTA ====================
       Misma estructura que cada sección de Clínica Alemana: un H2 corto, una
       frase que lo explica, y debajo la grilla. -->
  <section class="seccion razones" id="por-que">
    <div class="contenedor">
      <div class="encabezado-seccion centrado">
        <h2>Por qué Conecta</h2>
        <p>Cuatro cosas que puedes comprobar antes de pedir hora.</p>
      </div>

      <div class="razones-rejilla">
        {
          RAZONES.map((r, i) => (
            <a class="razon" href={r.href} style={`--escalon:${i}`}>
              <span class="razon-cifra">{r.cifra}</span>
              <span class="razon-titulo">{r.titulo}</span>
              <span class="razon-texto">{r.texto}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== ¿QUÉ NECESITAS HACER? ==================== -->
  <section class="seccion tareas revelar">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <h2>¿Qué necesitas hacer?</h2>
        <p>Cuatro caminos, sin llamar por teléfono para averiguar.</p>
      </div>
      <div class="tareas-rejilla">
        {
          TAREAS.map((t, i) => (
            <a class="tarea" href={t.href} style={`--escalon:${i}`}>
              <span class="tarea-icono">
                <Icono nombre={t.icono} tam={24} color="var(--color-blue)" />
              </span>
              <span class="tarea-titulo">{t.titulo}</span>
              <span class="tarea-texto">{t.texto}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== PRESTACIONES ==================== -->
  <section class="seccion prestaciones revelar">
    <div class="contenedor">
      <div class="encabezado-seccion con-enlace">
        <div>
          <h2>Qué atendemos</h2>
          <p>
            Una consulta que ordena el problema, y tres miradas que existen porque
            un problema hematológico rara vez se resuelve mirando solo la sangre.
          </p>
        </div>
        <Boton href={RUTAS.prestaciones} variante="secondary" icono="arrow-right" posicionIcono="right">
          Ver todas
        </Boton>
      </div>

      <div class="prestaciones-rejilla">
        {
          servicios.map((s) => (
            <TarjetaPrestacion
              nivel={s.data.nivel}
              titulo={s.data.nombre}
              resumen={s.data.resumen}
              href={RUTAS.prestacion(s.data.slug)}
              icono={s.data.icono}
              imagen={fotoDePrestacion(s.data.slug)?.src}
              altImagen={fotoDePrestacion(s.data.slug)?.alt}
              chips={s.data.modalidades}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== CÓMO ATENDEMOS · video de fondo ==================== -->
  <section class="atencion">
    <div class="atencion-fondo">
      <picture>
        <source media="(orientation: portrait)" srcset="/video/v-clinica-vertical.jpg" />
        <img class="atencion-poster" src="/video/v-clinica.jpg" alt="" aria-hidden="true" />
      </picture>
      <video
        class="atencion-video"
        id="video-atencion"
        preload="none"
        muted
        loop
        playsinline
        aria-hidden="true"
        data-horizontal="/video/v-clinica.mp4"
        data-vertical="/video/v-clinica-vertical.mp4"></video>
      <span class="atencion-velo" aria-hidden="true"></span>
    </div>

    <div class="contenedor atencion-texto">
      <p class="eyebrow claro">Cómo atendemos</p>
      <h2>Cómo atendemos</h2>
      <p class="atencion-bajada">
        Cuatro compromisos, escritos para que nos los cobres.
      </p>
      <ul class="compromisos">
        {a.compromisos.map((c) => (
          <li>
            <Icono nombre="check" tam={20} color="#8fb8f0" />
            <span>{c}</span>
          </li>
        ))}
      </ul>
      <div class="atencion-acciones">
        <Boton href={RUTAS.conocenos} variante="secondary" icono="arrow-right" posicionIcono="right">
          Conócenos
        </Boton>
      </div>
    </div>
  </section>

  <!-- ==================== DÓNDE ESTAMOS ==================== -->
  <section class="seccion ubicacion revelar">
    <div class="contenedor ubicacion-rejilla">
      <div>
        <h2>Dónde estamos</h2>
        <p class="ubicacion-detalle">
          {cl.direccion.edificio}, {cl.direccion.calle}, {cl.direccion.oficina}.
          {cl.direccion.comuna}, {cl.direccion.ciudad} — {cl.direccion.referencia}.
        </p>
        <ul class="horario">
          {cl.horarios.map((h) => <li>{horarioLegible(h)}</li>)}
        </ul>
        <div class="ubicacion-acciones">
          <Boton href={RUTAS.contacto} variante="secondary" icono="map-pin">
            Cómo llegar
          </Boton>
        </div>
      </div>
      <div class="ubicacion-nota">
        <p class="ubicacion-nota-titulo">¿Vives fuera de Santiago?</p>
        <p>
          La consulta por telemedicina resuelve la mayor parte de los controles y
          las segundas opiniones, sin que viajes.
        </p>
        <Boton href={RUTAS.telemedicina} variante="text" icono="arrow-right" posicionIcono="right">
          Ver cómo funciona
        </Boton>
      </div>
    </div>
  </section>

  <!-- ==================== PREGUNTAS ==================== -->
  <section class="seccion preguntas revelar">
    <div class="contenedor preguntas-rejilla">
      <div class="preguntas-intro">
        <h2>Preguntas frecuentes</h2>
        <p>
          Lo que más nos preguntan. Las respuestas clínicas las revisa y firma un
          hematólogo antes de publicarse.
        </p>
        <Boton href={RUTAS.preguntas} variante="secondary" icono="arrow-right" posicionIcono="right">
          Ver todas
        </Boton>
      </div>
      <div class="preguntas-lista">
        <Acordeon
          items={destacadas.map((f) => ({ q: f.data.pregunta, a: f.data.respuestaCorta }))}
          abrirPrimera
        />
      </div>
    </div>
  </section>

  <!-- ==================== CIERRE ==================== -->
  <section class="cierre revelar">
    <div class="contenedor cierre-caja">
      <div>
        <h2>Solicita tu hora</h2>
        <p>
          Consulta {precioCLP(a.precioConsulta)}. {a.precioNota} Te confirmamos
          día y hora por el canal que prefieras.
        </p>
      </div>
      <Boton href={RUTAS.agendar} variante="primary" tam="lg" icono="calendar">
        Solicitar hora
      </Boton>
    </div>
  </section>

  <!-- Barra de acción fija en móvil. Aparece al pasar el hero, que es donde el
       bloque de reserva sale de pantalla y el visitante se queda sin manera de
       agendar hasta el pie. Es el patrón que más convierte en móvil y no lo usa
       ninguno de los trece sitios revisados. -->
  <div class="barra-movil" id="barra-movil" aria-hidden="true">
    <span class="barra-movil-precio">Consulta {precioCLP(a.precioConsulta)}</span>
    <Boton href={RUTAS.agendar} variante="primary" icono="calendar" tam="sm">Solicitar hora</Boton>
  </div>
</Base>

<script>
  /* Mismo criterio que el hero de la portada actual: el video solo se descarga
     cuando la sección se acerca, solo tapa su póster mientras corre de verdad, y
     el teléfono recibe la versión vertical para no estirar píxeles ni recortar
     el 73% del encuadre. */
  /* Barra de acción fija en móvil. Aparece cuando el bloque de reserva del hero
     sale de pantalla, que es el momento en que el visitante se queda sin manera
     de agendar hasta llegar al pie. */
  const reserva = document.querySelector<HTMLElement>('.reserva');
  const barra = document.getElementById('barra-movil');

  if (reserva && barra) {
    new IntersectionObserver(
      ([e]) => {
        if (!e) return;
        const mostrar = !e.isIntersecting && e.boundingClientRect.top < 0;
        barra.toggleAttribute('data-visible', mostrar);
        barra.setAttribute('aria-hidden', mostrar ? 'false' : 'true');
      },
      { threshold: 0 },
    ).observe(reserva);
  }

  const seccion = document.querySelector<HTMLElement>('.atencion');
  const video = document.getElementById('video-atencion') as HTMLVideoElement | null;

  if (seccion && video) {
    const quietud = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conexion = (navigator as { connection?: { saveData?: boolean } }).connection;
    const sinVideo = quietud.matches || Boolean(conexion?.saveData);

    if (!sinVideo) {
      video.addEventListener('playing', () => video.classList.add('corriendo'));
      for (const ev of ['pause', 'ended', 'error', 'stalled']) {
        video.addEventListener(ev, () => video.classList.remove('corriendo'));
      }

      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              if (!video.getAttribute('src')) {
                const vertical = window.matchMedia('(orientation: portrait)').matches;
                video.src =
                  (vertical ? video.dataset['vertical'] : video.dataset['horizontal']) ?? '';
                video.preload = 'auto';
              }
              video.play().catch(() => {});
            } else if (!video.paused) {
              video.pause();
            }
          }
        },
        { rootMargin: '200px 0px' },
      );
      observador.observe(seccion);
    }
  }
</script>

<style>

  /* ==========================================================================
     MOVIMIENTO

     Un gesto orquestado —la entrada del hero— y micro-interacciones. No hay
     efectos sueltos repartidos por la página: eso es lo que hace que un sitio
     se sienta hecho a pedazos.

     Todo bajo prefers-reduced-motion: no-preference. Con movimiento reducido no
     se anima nada y la página se ve completa desde el primer fotograma, no a
     medio aparecer.
     ========================================================================== */

  /* `backwards`, no `forwards`. La diferencia importa: con `forwards` el estado
     final lo fija la animación, así que si el motor de animación no corre —una
     pestaña en segundo plano, un navegador con el reloj detenido— el elemento se
     queda en opacity 0 y el hero aparece en blanco. Con `backwards` el relleno
     se aplica solo ANTES de empezar, y al terminar el elemento vuelve a su
     estilo base, que es visible. El peor caso pasa de "hero invisible" a "hero
     sin animar". */
  .entra {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .entra {
      animation: entrada 620ms var(--ease-out) backwards;
      animation-delay: var(--retraso, 0ms);
    }
  }

  @keyframes entrada {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* La fotografía del hero se aleja despacio mientras se scrollea, y el velo se
     cierra. Da la sensación de que el contenido sube por encima de la imagen en
     vez de que la imagen se vaya de golpe. Es scroll-driven en CSS: cero JS. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero-fondo {
        animation: alejar linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
      .hero-velo {
        animation: cerrar-velo linear both;
        animation-timeline: view();
        animation-range: cover 20% cover 100%;
      }
      /* Las tarjetas de tarea entran escalonadas cuando la sección aparece. */
      .tarea {
        animation: entrada linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 26%;
        animation-delay: calc(var(--escalon, 0) * -40ms);
      }
    }
  }

  @keyframes alejar {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes cerrar-velo {
    to {
      opacity: 1.35;
    }
  }

  /* ==========================================================================
     BARRA DE ACCIÓN FIJA EN MÓVIL
     ========================================================================== */
  .barra-movil {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--margin-x);
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    border-top: var(--border-width) solid var(--color-line);
    transform: translateY(105%);
    transition: transform var(--dur-mid) var(--ease-out);
  }
  @media (max-width: 899px) {
    .barra-movil {
      display: flex;
    }
  }
  .barra-movil[data-visible] {
    transform: none;
  }
  .barra-movil-precio {
    font-weight: var(--weight-semibold);
    color: var(--color-blue-deep);
    font-size: var(--text-body-sm);
    font-variant-numeric: tabular-nums;
  }

  /* ==================== HERO ==================== */
  .hero {
    position: relative;
    background: var(--color-blue-deep);
    display: flex;
    align-items: flex-end;
    min-height: 62svh;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .hero {
      min-height: 68svh;
      align-items: center;
    }
  }

  .hero-fondo {
    position: absolute;
    inset: 0;
  }
  .hero-fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Velo propio, no el `--velo` del sitio. Ese está calibrado para un hero de
     pantalla completa, donde el texto va abajo; acá el hero mide 62svh y el
     texto va al centro-izquierda, así que aplicado tal cual tapaba la fotografía
     entera y el hero se veía como un bloque azul liso.

     Este va de izquierda a derecha: fuerte donde está el titular, y se abre
     hacia la derecha, que es donde va el bloque blanco de reserva y donde
     conviene que la fotografía se vea. */
  .hero-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6, 24, 54, 0.78) 0%,
      rgba(6, 24, 54, 0.62) 45%,
      rgba(6, 24, 54, 0.72) 100%
    );
  }
  @media (min-width: 900px) {
    .hero-velo {
      background: linear-gradient(
        to right,
        rgba(6, 24, 54, 0.9) 0%,
        rgba(6, 24, 54, 0.74) 40%,
        rgba(6, 24, 54, 0.4) 72%,
        rgba(6, 24, 54, 0.34) 100%
      );
    }
  }

  /* El padding superior tiene que despejar la cabecera transparente, que mide
     80 px en escritorio y 64 en móvil. Con var(--space-16) el eyebrow quedaba
     pegado al logo. */
  .hero-rejilla {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-8);
    padding-block: calc(64px + var(--space-8)) var(--space-12);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-rejilla {
      grid-template-columns: minmax(0, 1fr) 25rem;
      gap: var(--space-16);
      padding-block: calc(80px + var(--space-8)) var(--space-16);
    }
  }

  .hero-texto {
    color: #fff;
  }
  .hero-eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-semibold);
