---
/* Layout de página interior.

   Reescrito junto con la portada. Antes la cabecera de página era un bloque de
   texto sobre blanco y la fotografía venía después, como una banda suelta: el
   mismo error que tenía el hero de la portada, repetido trece veces.

   Ahora la fotografía ES la cabecera. Migas, eyebrow, H1 y bajada van encima,
   con el mismo tratamiento de velo y de cabecera transparente que la portada,
   pero a media altura: una página interior no necesita ocupar toda la pantalla
   antes de mostrar contenido.

   Sin `foto`, cae al bloque de texto sobre blanco de antes. Los textos legales
   no necesitan una fotografía, y ponerles una sería relleno. */
import Base from './Base.astro';
import Migas from '../components/navigation/Migas.astro';
import { Picture } from 'astro:assets';
import type { Miga } from '../lib/rutas';
import type { Foto } from '../lib/imagenes';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  actual?: string;
  h1: string;
  bajada?: string | undefined;
  eyebrow?: string | undefined;
  migas: Miga[];
  jsonLd?: unknown[];
  anchoTexto?: boolean;
  noindex?: boolean;
  imagenOg?: string | undefined;
  foto?: Foto | undefined;
}

const {
  titulo,
  descripcion,
  ruta,
  actual,
  h1,
  bajada,
  eyebrow,
  migas,
  jsonLd = [],
  anchoTexto = false,
  noindex = false,
  imagenOg,
  foto,
} = Astro.props;
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  ruta={ruta}
  actual={actual}
  migas={migas}
  jsonLd={jsonLd}
  noindex={noindex}
  imagenOg={imagenOg}
>
  {
    foto ? (
      <section class="portada">
        <div class="fondo">
          <Picture
            src={foto.src}
            alt={foto.alt}
            widths={[800, 1280, 1920]}
            sizes="100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            loading="eager"
            fetchpriority="high"
          />
          <span class="velo" aria-hidden="true" />
        </div>
        <div class="texto contenedor">
          <Migas items={migas} />
          {eyebrow && <p class="eyebrow arriba">{eyebrow}</p>}
          <h1 class:list={['titulo', anchoTexto && 'angosto']}>{h1}</h1>
          {bajada && <p class="bajada">{bajada}</p>}
        </div>
        <span class="borde-inferior" aria-hidden="true" />
      </section>
    ) : (
      <div class="encabezado-simple">
        <div class="contenedor">
          <Migas items={migas} />
          {eyebrow && <p class="eyebrow arriba">{eyebrow}</p>}
          <h1 class:list={['titulo', anchoTexto && 'angosto']}>{h1}</h1>
          {bajada && <p class="bajada">{bajada}</p>}
        </div>
      </div>
    )
  }

  <slot />
</Base>

<style>
  /* ---------- cabecera con fotografía ---------- */
  .portada {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 62svh;
    overflow: hidden;
    background: var(--color-blue-deep);
  }
  @media (min-width: 900px) {
    .portada {
      min-height: 70svh;
    }
  }

  .fondo {
    position: absolute;
    inset: 0;
  }
  .fondo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .velo {
    position: absolute;
    inset: 0;
    background: var(--velo);
  }

  .texto {
    position: relative;
    padding-block: var(--space-16) var(--space-12);
    color: #fff;
  }
  @media (min-width: 900px) {
    .texto {
      padding-block: var(--space-20) var(--space-16);
    }
  }

  /* Las migas y el eyebrow sobre fotografía necesitan su propia tinta.

     Subieron dos escalones, no uno. Contra el velo anterior el celeste #a9c4e8
     daba 9,8:1; contra el nuevo, 4,0 —bajo AA para texto pequeño—. Midiendo las
     ocho cabeceras del sitio, el primer ajuste todavía dejaba /conocenos/ en
     4,13 y /telemedicina/ en 3,70.

     Aclarar la tinta es la palanca barata: gana contraste sin oscurecer un solo
     píxel de la fotografía, que es justo lo contrario de subir el velo. Lo que
     se pierde es la jerarquía de color entre eyebrow y titular; se sostiene con
     tamaño, versalitas y espaciado, que sobre foto funcionan mejor igual. */
  .texto :global(.migas a) {
    color: #fff;
  }
  .texto :global(.migas a:hover) {
    color: #fff;
  }
  /* La miga de la pagina actual no es enlace, asi que no lleva subrayado que
     la ayude: todo su contraste es color. En /contacto/ y /prestaciones/ se
     quedaba en 4,4:1. */
  .texto :global(.migas span[aria-current]) {
    color: #f2f7fd;
  }

  /* Blanco puro, como el titular. En /contacto/, /prestaciones/ y la
     prestación de hematología —tres fotografías claras— el celeste se quedaba
     entre 4,1 y 4,4:1. Blanco da un 11 % más de contraste sin tocar el velo, y
     el eyebrow no necesita el color para distinguirse: ya lo hacen el cuerpo
     chico, la versalita y el espaciado de letras. */
  .portada .eyebrow {
    color: #fff;
  }
  .portada .titulo {
    color: #fff;
    font-size: clamp(2.15rem, 1.5rem + 2.6vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-shadow: var(--sombra-sobre-foto);
  }
  .portada .bajada {
    color: #f2f7fd;
    text-shadow: var(--sombra-sobre-foto);
    /* La medida de prosa —pensada para un párrafo sobre blanco— dejaba la
       bajada corriendo hasta el 55 % del ancho, fuera de la meseta del velo.
       En /precios/ eso la hundía a 3,2:1 y subir la meseta no la salvaba: los
       píxeles que fallaban estaban pasada la meseta, no dentro.

       46ch la devuelve adentro. Es además la medida que ya usa el hero de la
       portada, y a 1200 px de contenedor la línea pasa de ~110 caracteres a
       ~46: la cabecera se lee mejor aparte de medir mejor. */
    max-width: 46ch;
  }

  /* ---------- en móvil la foto es banda, no fondo ----------

     Medido a 375 px sobre esta misma cabecera: con el texto ocupando todo el
     ancho —la bajada llega al 90 %—, el velo original daba 1,67:1 en las migas
     y 1,94:1 en el eyebrow. Es decir: la cabecera en móvil YA incumplía AA
     antes de tocar nada, y no por poco.

     Buscando un velo vertical que lo arreglara, lo único que pasaba era 0,90 de
     opacidad sobre el 64 % del alto: oscurecimiento medio 0,758 contra 0,470 de
     hoy. Arreglar la accesibilidad tapando la fotografía es justo lo contrario
     de lo que se pidió.

     Así que en móvil el texto deja de ir encima. La fotografía pasa a ser una
     banda y el texto cae debajo, sobre azul sólido: la foto se ve casi limpia
     —velo de 0,14, sólo para que no se despegue de la paleta— y el texto queda
     en 8,5:1 sin depender de qué haya detrás. Es más claro Y accesible, que
     sobre una foto con una ventana quemada no se podía a la vez.

     En escritorio no hace falta: ahí el texto ocupa la mitad izquierda y la
     meseta del velo lo sostiene. */
  @media (max-width: 899px) {
    .portada {
      display: grid;
      grid-template-rows: auto auto;
      align-items: stretch;
      min-height: 0;
    }
    .fondo {
      position: relative;
      inset: auto;
      aspect-ratio: 16 / 10;
    }
    .velo {
      background: rgba(var(--velo-tinta), 0.14);
    }
    .texto {
      padding-block: var(--space-7) var(--space-9);
    }
    /* Sobre azul sólido la sombra ya no defiende de nada y ensucia el trazo. */
    .portada .titulo,
    .portada .bajada {
      text-shadow: none;
    }
  }

  .borde-inferior {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--color-blue);
  }

  /* ---------- cabecera sin fotografía ---------- */
  .encabezado-simple {
    padding-block: var(--space-8) var(--space-10);
    border-bottom: var(--border-width) solid var(--color-line);
  }
  @media (min-width: 768px) {
    .encabezado-simple {
      padding-block: var(--space-10) var(--space-16);
    }
  }

  /* ---------- común ---------- */
  .arriba {
    margin-top: var(--space-8);
  }
  .titulo {
    margin-top: var(--space-4);
    max-width: 22ch;
  }
  .titulo.angosto {
    max-width: 18ch;
  }
  .bajada {
    margin-top: var(--space-5);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-gray);
    max-width: var(--measure-prose);
  }
</style>
