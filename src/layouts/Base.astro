---
/* Armazón de todas las páginas.

   Desde el 2026-09-08 monta la cabecera de v3 —franja de utilidad, cabecera
   pegada que encoge, logo con el nombre en texto— y, en móvil, la barra de
   acciones fija al pie. Es la decisión de tomar v3 como diseño del sitio
   completo; Encabezado.astro, la cabecera anterior, quedó en el historial.

   Ya no existe `heroSuelto`. Esa propiedad servía para montar la cabecera
   transparente encima de un hero a pantalla completa; la cabecera de v3 es
   siempre sólida y el contenido empieza debajo, como en el diseño. */
import '../styles/global.css';
import Meta from '../components/seo/Meta.astro';
import CabeceraV3 from '../components/v3/CabeceraV3.astro';
import BarraMovilV3 from '../components/v3/BarraMovilV3.astro';
import PieDeSitio from '../components/navigation/PieDeSitio.astro';
import { ajustes, pais } from '../lib/contenido';
import { clinicaJsonLd, migasJsonLd } from '../lib/schema';
import type { Miga } from '../lib/rutas';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  actual?: string;
  noindex?: boolean;
  migas?: Miga[];
  jsonLd?: unknown[];
  imagenOg?: string | undefined;
}

const {
  titulo,
  descripcion,
  ruta,
  actual,
  noindex = false,
  migas = [],
  jsonLd = [],
  imagenOg,
} = Astro.props;

const a = await ajustes();
const cl = (await pais('cl')).data;
const sitio = Astro.site?.toString() ?? 'https://conectamedica.com/';

// La ficha de la clínica va en todas las páginas: es la entidad del sitio.
const bloques: unknown[] = [clinicaJsonLd(a, cl, sitio), ...jsonLd];
if (migas.length > 1) bloques.push(migasJsonLd(migas, sitio));
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#12489E" />
    <Meta
      titulo={titulo}
      descripcion={descripcion}
      ruta={ruta}
      noindex={noindex}
      jsonLd={bloques}
      imagenOg={imagenOg}
    />
  </head>
  <body>
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>
    <CabeceraV3 actual={actual} />
    <main id="contenido">
      <slot />
    </main>
    <PieDeSitio />
    <BarraMovilV3 />
  </body>
</html>
